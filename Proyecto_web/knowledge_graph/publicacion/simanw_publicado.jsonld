    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El primer A350ULR yéndose al aire por primera vez – Airbus SAS 2026\n\nHace unas horas se ha producido el primer vuelo del Airbus A350-1000ULR, el que será el avión comercial de más alcance del mundo. Este ejemplar, que lleva instrumentación especial para vuelos de prueba, y que iba tripulado por personal de la empresa, voló durante tres horas y 43 m"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Primer vuelo del Airbus A350-1000ULR, el que será el avión comercial con más alcance del mundo, capaz de unas 22 horas seguidas en el aire"
      }
    ],
