  {
    "@id": "https://simanw.local/recurso/noticia_261_8a34af3fd8",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Tras Pedro Duque y Miguel López-Alegría, será el tercer español que podrá viajar al espacio. La Agencia Espacial Europea (ESA) ha celebrado este lunes su graduación y la de los otros cuatro candidatos a astronauta de su última promoción."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Se gradúa Pablo Álvarez, el astronauta español del siglo XXI"
      }
    ],
