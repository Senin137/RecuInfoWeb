    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El apagón que afectó la península ibérica la pasada semana ha expuesto la vulnerabilidad de un sistema eléctrico en plena transformación. La transición energética no solo implica descarbonizar la generación, sino también adaptar infraestructuras y tecnologías para garantizar un suministro seguro y estable."
      }
    ],
