    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "¡Avances en análisis genéticos! Curiosa esta historia de Seth Howes, un tipo con formación en medicina y algo de IA que se compró un secuenciador de ADN portátil adecuado para la labor y luego desarrolló el software apropiado para realizar una secuenciación de un ADN humano completo con «cobertura 30×», casi como en los laboratorios.\n\n¿Cómo se hace"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El tipo que secuenció un ADN completo en casa con un equipo portátil, software desarrollado por él mismo, ayuda de una IA y algo de aprendizaje"
      }
    ],
