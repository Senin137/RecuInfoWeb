    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Una joven de Girona ha sorprendido a todos en TikTok tras relatar la angustiosa experiencia que vivió junto a dos amigas el pasado año en Marrakech. Lo que prometía ser un viaje de relax tras una excursión terminó convirtiéndose, según describe la propia protagonista en su red social, en una auténtica e inesperada película de suspense."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
