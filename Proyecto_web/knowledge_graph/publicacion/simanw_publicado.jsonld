    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un proyecto internacional halla medidas más precisas que reducen el abanico de modelos posibles sobre la evolución del universo. Los resultados combinan lentes gravitacionales débiles y el agrupamiento de galaxias, e integran por primera vez cuatro cuantificaciones diferentes de la energía oscura en un único experimento."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
