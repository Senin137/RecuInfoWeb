    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Aunque han pasado varios años desde que abandonó 'La que se avecina', Luis Miguel Seguí sigue siendo una de las caras más recordadas de la popular comedia. El actor, que dio vida a Leo durante gran parte de la trayectoria de la serie, ha repasado algunos de los momentos más destacados de aquella etapa en una entrevista para el pódcast 'Animales Hum"
      }
    ],
