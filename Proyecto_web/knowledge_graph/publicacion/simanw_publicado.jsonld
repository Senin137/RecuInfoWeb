    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Hoy parece un ladrillo pero este celular es un antepasado de nuestros modernos teléfonos inteligentes. Y aunque no lo parezca, tiene algo en común con un iPhone4: por suerte no es su peso."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "¿En qué se parece un celular de hace 20 años al iPhone4?"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://www.bbc.co.uk/mundo/noticias/2014/08/140818_tecnologia_aniversario_telefono_inteligente_ig.shtml"
      }
    ],
