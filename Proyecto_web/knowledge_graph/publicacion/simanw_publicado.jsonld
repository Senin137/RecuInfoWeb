    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Según cuenta la Biblia, antes del diluvio universal, Dios se aseguró de que hubiera un arca para salvar la vida que había creado. A menor escala, con el tsunami en Japón, una barquita desempeñó un rol similar."
      }
