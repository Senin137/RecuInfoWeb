  {
    "@id": "https://simanw.local/recurso/noticia_270_6d6cb319d8",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Hasta ahora el récord de permanencia en el espacio, sumando diversas misiones, lo ostentaba el ruso Guennadi Padalka con 878 días, pero este fin de semana su compatriota Oleg Kononenko ha superado ese tiempo durante su estancia en la Estación Espacial Internacional. Cuando regrese a la Tierra en septiembre dejará la marca en 1.110 días."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El cosmonauta Oleg Kononenko establece un nuevo récord mundial de estancia en el espacio"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/El-cosmonauta-Oleg-Kononenko-establece-un-nuevo-record-mundial-de-estancia-en-el-espacio"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "tecnologia"
      }
