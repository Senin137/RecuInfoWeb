  {
    "@id": "https://simanw.local/recurso/noticia_300_25ec44e31c",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Durante una presentación de las naves del programa lunar Artemis, el administrador de la NASA, Bill Nelson, ha declarado: \"No quiero que China llegue primero al polo sur y diga: 'Es nuestro, fuera'. Queremos estar seguros de que está disponible para todos y proteger los intereses de la comunidad internacional\"."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "EE UU quiere pisar el polo sur de la Luna antes que China"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/EE-UU-quiere-pisar-el-polo-sur-de-la-Luna-antes-que-China"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
