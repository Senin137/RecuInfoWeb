    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El alemán ofrece un recital, tras un primer set muy debatido, y accede por quinta vez a las semifinales en las seis últimas ediciones: 7-6(3), 6-1 y 6-3, tras 2h 25m"
      }
    ],
