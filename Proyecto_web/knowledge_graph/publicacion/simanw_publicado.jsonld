    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La influencer y empresaria catalana Jessica Goicoechea puso fin a su mediática relación con Manu Moreno durante el verano de 2025 y todo apuntaba a que sus caminos habían tomado direcciones distintas para siempre. Sin embargo, varios meses después, la historia ha dado un giro inesperado."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
