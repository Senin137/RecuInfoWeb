    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Desde hace meses los cibercriminales \"secuestran\" cuentas de usuarios inocentes para hacer páginas de productos falsas y robar datos personales. BBC Mundo le cuenta qué medidas se pueden tomar contra este fraude."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "¿Cómo evitar las trampas de los hackers en eBay?"
      }
    ],
