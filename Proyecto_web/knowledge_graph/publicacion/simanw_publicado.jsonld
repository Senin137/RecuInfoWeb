    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Las observaciones de este satélite han revelado que existe una diferencia significativa entre sus dos caras. No obstante, un nuevo estudio que analiza muestras lunares procedentes de la cuenca del Polo Sur Aitken señala que comparten características isotópicas y geoquímicas."
      }
    ],
