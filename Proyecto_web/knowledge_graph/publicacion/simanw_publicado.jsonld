  {
    "@id": "https://simanw.local/recurso/noticia_343_12b2e2bb6d",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Gracias al radiotelescopio ALMA, un proyecto internacional ha revelado una red de filamentos de gas cósmico en el corazón de la galaxia. Es la primera vez que se detecta el gas frío —la materia prima de las estrellas— con este detalle. Los hallazgos permitirán profundizar en el conocimiento de la región más extrema de la Vía Láctea."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Una nueva imagen del centro de la Vía Láctea revela su química oculta con un detalle sin precedentes"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/Una-nueva-imagen-del-centro-de-la-Via-Lactea-revela-su-quimica-oculta-con-un-detalle-sin-precedentes"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "ciencia"
      }
    ],
