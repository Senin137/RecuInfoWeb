    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Dos estudios coliderados por el Instituto de Astrofísica de Andalucía han observado con un detalle sin precedentes la región Sagitario C, situada cerca del centro galáctico. Los hallazgos ayudan a entender por qué la tasa de formación estelar es más baja de lo esperado en una zona tan rica en gas."
      }
    ],
