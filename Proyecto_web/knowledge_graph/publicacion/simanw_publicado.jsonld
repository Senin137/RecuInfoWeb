    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El 28 de abril de 2025 quedará recordado como el día que se produjo un gran apagón en España. Un año después, se conoce que la causa fueron una combinación de factores técnicos y desconexiones en cascada, y se siguen tomando medidas para que no vuelva a ocurrir."
      }
