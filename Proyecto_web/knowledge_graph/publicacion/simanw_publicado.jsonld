    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Martina Klein presentó el nuevo Lotus Connected Full D, el nuevo reloj conectado de Festina Group con una autonomía de 10 días. La modelo, mujer del ex tenista Àlex Corretja, se mostró feliz con el nuevo reloj de la colección Connected, que es el equilibrio perfecto entre estar conectada a tu smartphone sin renunciar al estilo."
      }
    ],
