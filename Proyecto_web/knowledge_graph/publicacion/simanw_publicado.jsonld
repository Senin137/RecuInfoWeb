    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un estudio con participación española ha logrado la medición más precisa de la masa de los neutrinos, la partícula más ligera del universo. El valor se ha fijado 0,45 electrovoltios, una millonésima parte de la que tiene un electrón."
      }
