    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Una nueva investigación del Instituto de Astrofísica de Andalucía ha analizado cómo influyen los vacíos cósmicos en la evolución de doscientas galaxias. Estas regiones se caracterizan por tener una densidad de materia muy baja, lo que permite que sean entornos ideales para el estudio de la actividad estelar."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
