    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Las pocas opciones que tiene una persona de que le toque la lotería son el motivo de que la historia de Adam López sea tan llamativa.&nbsp;Este hombre inglés, de 39 años y residente de Mattishall, Norfolk, vio cómo su vida cambiaba de la noche a la mañana tras ganar un gran premio el pasado mes de julio de 2025."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
