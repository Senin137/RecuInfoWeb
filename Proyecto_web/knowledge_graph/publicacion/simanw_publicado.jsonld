    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Este jueves se ha lanzado la misión Ax-3 de Axiom Space rumbo al complejo orbital, donde sus cuatro tripulantes realizarán más de 30 experimentos científicos. Además del comandante hispanoestadounidense, viajan a bordo un piloto italiano y dos especialistas, uno turco y otro sueco de la Agencia Espacial Europea."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
