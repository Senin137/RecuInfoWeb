    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un nuevo análisis de este experimento internacional que mapea el universo en 3D sugiere que la energía oscura, considerada hasta ahora una constante, podría evolucionar. Si se confirma, este hallazgo desafiaría el modelo estándar y abriría nuevas vías en la comprensión del cosmos."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
