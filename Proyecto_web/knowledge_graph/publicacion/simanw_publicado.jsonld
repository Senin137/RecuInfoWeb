    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El Castell de Montjuïc de Barcelona cambió por un día su habitual tranquilidad por la adrenalina de la competición. Sus murallas, patios y pasillos acogieron la On Squad Race, un innovador evento de running por equipos impulsado por la marca suiza On que reunió a 192 corredores en una experiencia tan exigente como divertida."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
