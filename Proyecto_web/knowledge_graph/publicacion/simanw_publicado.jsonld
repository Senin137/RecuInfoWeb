  {
    "@id": "https://simanw.local/recurso/noticia_255_46fac3a09c",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Tras tres intentos fallidos, esta vez las dos etapas de la nave más potente del mundo han regresado de forma controlada a la Tierra: una a las aguas del golfo de México y otra al Índico. El avance allana el camino de Estados Unidos para regresar a la Luna y llegar a Marte."
      }
    ],
