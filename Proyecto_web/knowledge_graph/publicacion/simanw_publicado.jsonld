    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Factorial, la principal plataforma europea de IA para la gestión de equipos, ha anunciado hoy el cierre de una ronda de financiación de Serie D de 150 millones de dólares (129 millones de euros), que valora la compañía en 2.500 millones de dólares (2.145 millones de euros). Esto la sitúa entre las scale up más valiosas de España y de Europa.&nbsp;L"
      }
    ],
