    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Si todo sale según lo previsto, a partir de esta madrugada en España el mundo volverá a mirar al cielo con la expectación de una nueva etapa en la exploración espacial, en la que cuatro astronautas podrán contemplar en directo la cara oculta de la Luna, una experiencia reservada a muy pocos, aunque sin llegar a pisar su superficie."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
