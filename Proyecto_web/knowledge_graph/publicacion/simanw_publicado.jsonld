  {
    "@id": "https://simanw.local/recurso/noticia_458_4330226c1d",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "En el Antiguo Egipto, si un gato familiar moría, todos los miembros de la familia se depilaban las cejas en señal de duelo. Los gatos, a lo largo de la historia, han adquirido un estatus envidiable.\n\nSin embargo, más allá del devocionario humano, también es cierto que los gatos presentan algunas características ciertamente sorprendentes. Sobre todo"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Los gatos tienen una gran capacidad para crear sonidos y también para escucharlos"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.xatakaciencia.com/sabias-que/gatos-tienen-gran-capacidad-para-crear-sonidos-tambien-para-escucharlos"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
