    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Microsoft ha lanzado su primer modelo de inteligencia artificial orientado al desarrollo de software. Conocido como MAI-Code-1-Flash, la nueva IA compite contra los modelos ligeros de Anthropic, Google y otras empresas. El modelo se integra a GitHub Copilot a partir de hoy y también está disponible para usuarios individuales a través de Visual Stud"
      }
