    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Para cualquier conductor es imprescindible poder acreditar la validez de su permiso. Conducir con un carnet caducado puede acarrear hasta 200 euros de multa y un delito grave, aunque no conlleva pérdida de puntos. Según la normativa de Tráfico, en el momento de ponerse al volante, el permiso debe ser válido y estar vigente.&nbsp;"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
