    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "En la región del polo sur de la Luna existen zonas donde nunca luce el Sol y otras donde siempre llegan sus rayos. Para que los vehículos puedan operar en esas condiciones, y con fondos de la Agencia Espacial Europea, investigadores de España y Reino Unido desarrollan sistemas que combinan paneles solares, baterías y generadores termoeléctricos de "
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
