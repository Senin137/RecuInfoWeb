    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La expansión del jabalí por toda España sigue generando mucha preocupación por los daños que este animal provoca en cultivos, explotaciones ganaderas y carreteras. Es por ello, que en una región del sur de España se ha adoptado una medida excepcional con el objetivo de minimizar esta expansión."
      }
    ],
