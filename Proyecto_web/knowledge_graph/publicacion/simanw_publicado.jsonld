  {
    "@id": "https://simanw.local/recurso/noticia_400_da72ea5123",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Una estrella que desafía las reglas conocidas de la evolución estelar ha sido identificada gracias a la sensibilidad ultravioleta del telescopio espacial Hubble. Su composición superficial revela una historia violenta: la unión de dos astros que, al colisionar, dieron lugar a una enana blanca con características únicas."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El Hubble revela las secuelas de una extraña colisión entre estrellas"
