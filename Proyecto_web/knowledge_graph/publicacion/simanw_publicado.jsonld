  {
    "@id": "https://simanw.local/recurso/noticia_408_7f0249dd87",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un patrón detectado en los restos de una estrella ha confirmado que esta estalló en dos fases, lo que sugiere que algunas supernovas tipo Ia pueden originarse de esta forma. La observación, realizada con el Very Large Telescope, aporta nuevas pistas sobre estos fenómenos, fundamentales para comprender la evolución y la expansión del universo."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
