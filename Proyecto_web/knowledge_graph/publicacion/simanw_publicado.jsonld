    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un día después del despegue, la misión tripulada de la agencia espacial estadounidense llegó a destino para reemplazar al equipo que tuvo que abandonar la estación por una emergencia médica. El proceso de acoplamiento duró poco más de dos horas y transcurrió según lo planeado."
      }
    ],
