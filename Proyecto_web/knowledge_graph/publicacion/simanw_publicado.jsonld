  {
    "@id": "https://simanw.local/recurso/noticia_1353_f2db598883",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Las encuestas dan como favorito al senador de izquierda Iván Cepeda, del partido Pacto Histórico, el mismo de Petro; seguido por el ultraderechista Abelardo de la Espriella, del movimiento Defensores de la Patria, y por la senadora Paloma Valencia, del partido de derecha Centro Democrático."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
