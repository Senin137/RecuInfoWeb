    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Victor Wembanyama es la estrella del momento en la NBA y alguien destinado a marcar una época en la máxima competición de baloncesto estadounidense. El francés, de tan sólo 22 años, ha alcanzado sus primeras Finales de la NBA en su tercera temporada -y sus primeros Playoffs- con los San Antonio Spurs dejando por el camino a los Oklahoma City Thunde"
      }
    ],
