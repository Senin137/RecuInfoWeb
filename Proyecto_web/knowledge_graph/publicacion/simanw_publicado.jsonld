  {
    "@id": "https://simanw.local/recurso/noticia_483_fbd09243a0",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Según cuenta la Biblia, antes del diluvio universal, Dios se aseguró de que hubiera un arca para salvar la vida que había creado. A menor escala, con el tsunami en Japón, una barquita desempeñó un rol similar."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "¿Es realmente posible la vida en un arca?"
