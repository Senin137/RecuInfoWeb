  {
    "@id": "https://simanw.local/recurso/noticia_280_b6a3dee791",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Las dos particiones de esta gigantesca máquina, capaz de realizar hasta 314.000 billones de cálculos por segundo, se posicionan entre los 20 supercomputadores de mayor capacidad del planeta. El presidente Pedro Sánchez y el president Pere Aragonès han destacado su importancia para Cataluña, España y Europa durante la inauguración."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Inaugurado el MareNostrum 5, uno de los superordenadores más potentes de Europa y del mundo"
