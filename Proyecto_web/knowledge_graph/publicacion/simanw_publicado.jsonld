        "@id": "https://simanw.local/recurso/autor_mar%C3%ADa_g_dionis"
      }
    ],
    "https://simanw.local/ontology#fechaPublicacion": [
      {
        "@value": "Wed, 22 Oct 2025 17:00:20 +0200"
      }
    ],
    "https://simanw.local/ontology#fuenteTexto": [
      {
        "@language": "es",
        "@value": "https://www.agenciasinc.es/feed/Ciencia"
      }
    ],
    "https://simanw.local/ontology#publicadaPor": [
      {
        "@id": "https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"
      }
    ],
    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "El análisis conjunto de datos de dos de los grandes experimentos globales sobre neutrinos, el NOvA y el T2K, revela más información sobre el comportamiento de estas partículas fundamentales tan difíciles de estudiar. En concreto, desvela detalles de cómo se mezclan los neutrinos y su proceso de oscilación, útil para investigar la asimetría entre la"
      }
    ],
