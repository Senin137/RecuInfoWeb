    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Hay ascensiones al Everest que se miden en metros de desnivel, en horas de esfuerzo o en cifras de oxígeno consumido. Y luego están las que trascienden cualquier estadística para convertirse en una lección de vida. La protagonizada por Rustam Nabiev, alpinista ruso de 34 años, pertenece a esta última categoría."
      }
    ],
    "https://simanw.local/ontology#sentimientoEtiqueta": [
      {
        "@language": "es",
        "@value": "negativo"
      }
    ],
