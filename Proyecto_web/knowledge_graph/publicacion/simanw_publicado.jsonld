    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La Maker Faire Galicia celebra su duodécima edición y abre este sábado 6 de junio en el centro comercial Área Central de Santiago de Compostela, con más de 150 makers confirmados, 20 talleres gratuitos para todas las edades y cerca de 40 proyectos interactivos. El acto de presentación se celebró hoy en el Ayuntamiento de&#8230; Continúa leyendo »La"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Maker Faire Galicia arranca su XII edición este sábado: 150 makers y 20 talleres gratuitos"
      }
