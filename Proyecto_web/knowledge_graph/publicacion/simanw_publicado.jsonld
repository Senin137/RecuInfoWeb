  {
    "@id": "https://simanw.local/recurso/noticia_296_8085494383",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El Gobierno de España destinará 125 millones de euros al desarrollo de dos cargas útiles de satélite, uno geoestacionario y otro en órbita baja, junto a sus respectivas estaciones terrenas, para la llamada distribución cuántica de claves (QKD). Esta tecnología se podría incorporar en la constelación europea de comunicaciones seguras por satélite."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Claves cuánticas en la primera misión geoestacionaria española"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/Claves-cuanticas-en-la-primera-mision-geoestacionaria-espanola"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "tecnologia"
      }
    ],
    "https://simanw.local/ontology#escritaPor": [
      {
        "@id": "https://simanw.local/recurso/autor_sinc"
      }
    ],
    "https://simanw.local/ontology#fechaPublicacion": [
      {
        "@value": "Mon, 25 Sep 2023 14:57:15 +0200"
      }
    ],
    "https://simanw.local/ontology#fuenteTexto": [
      {
        "@language": "es",
        "@value": "https://www.agenciasinc.es/feed/Tecnologia"
      }
    ],
    "https://simanw.local/ontology#mencionaEntidad": [
      {
        "@id": "https://simanw.local/recurso/entidad_claves"
