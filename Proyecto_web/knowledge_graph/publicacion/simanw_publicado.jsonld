    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Corría el año 2018 cuando un equipo de científicos australianos detectó una extraña señal de radio en el plano de la Vía Láctea. El pulso de radio era demasiado lento para cualquier objeto astronómico conocido. Parecía más bien algún tipo de anomalía o error de los telescopios que un nuevo descubrimiento. Sin embargo, en 2025 se localizó otra señal"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Hemos pasado años desentrañando una señal del espacio que no debería existir. Y al fin tenemos una \"piedra Rosetta\" para descifrarla"
      }
    ],
