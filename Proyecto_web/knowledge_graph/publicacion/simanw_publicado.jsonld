    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Gracias al telescopio ALMA, un estudio internacional ha captado las imágenes más nítidas hasta la fecha de los cinturones de polvo que quedan tras la formación de los planetas. Estos discos son el equivalente cósmico de la ‘adolescencia’ de los sistemas planetarios, una etapa rodeada de misterio."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
