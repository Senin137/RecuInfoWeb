    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "No se trata de un acontecimiento astronómico insólito, tan solo un plenilunio más de los que ocurren cada mes. Para César González, divulgador del Planetario de Madrid, su peculiaridad se debe a su nombre, ya que los indígenas americanos la llamaban así por la recolección de fresas en este momento del año."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
