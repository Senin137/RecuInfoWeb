    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un estudio químico de rocas de ambas caras del satélite muestra que la lava de la que proceden se solidificó a diferentes temperaturas. Los investigadores creen que podría deberse a la menor concentración de elementos radiactivos en la cara oculta, que generan calor al desintegrarse."
      }
    ],
