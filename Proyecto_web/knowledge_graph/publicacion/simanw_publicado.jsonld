  {
    "@id": "https://simanw.local/recurso/noticia_910_bd7364e836",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Tras operativos en 12 estados del país durante el fin de semana, el gabinete de seguridad federal reportó ayer la detención de 33 personas y el aseguramiento de 2.2 toneladas de metanfetamina, 8 kilogramos de fentanilo y otras drogas, además de más de 90 mil cartuchos, 30 armas largas y más de 200 artefactos explosivos."
      }
    ],
