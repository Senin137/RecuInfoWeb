    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Cuando entre en vigor la próxima legislación, ya no servirán las estimaciones de un laboratorio sino los gases liberados por los coches circulando en carretera, según adelanta esta experta española del Centro Común de Investigación de la Comisión Europea. La química considera que ella y su equipo son el 'brazo' científico del órgano ejecutivo conti"
      }
    ],
