    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Investigadores de Suiza han construido un dron que puede caminar, saltar y emprender el vuelo con ayuda de patas parecidas a las de una ave, lo que amplía enormemente la gama de posibles entornos accesibles a los vehículos aéreos no tripulados. El avance ayudará a la mitigación de desastres o a las entregas en áreas confinadas."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
