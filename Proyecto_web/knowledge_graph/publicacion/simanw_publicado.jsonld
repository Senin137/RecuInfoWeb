    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Prestad atención a los primeros segundos del siguiente vídeo. Según lo que estéis pensando, según en qué se centre vuestro cerebro, podréis escuchar una frase u otra. La frase siempre será la misma, pero todas las veces que escuchéis el vídeo escucharéis una frase distinta si cambias de pensamiento.\n\nNo es un bug de Matrix. No es magia ni brujería."
      }
    ],
