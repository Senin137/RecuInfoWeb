    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Una cápsula Dragon de SpaceX despegó este martes comandada por el multimillonario Jared Isaacman, que junto a la ingeniera Sarah Gillis trataran de dar un paseo espacial este jueves. La nave ya superó esta noche los 1.400 km de distancia de la Tierra, el viaje tripulado más lejano desde las misiones Apolo hace más de 50 años."
      }
    ],
