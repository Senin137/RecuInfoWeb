    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Los puentes son elementos críticos de las redes de transporte, y su colapso puede tener consecuencias muy graves. Hasta ahora, no estaba claro por qué fallos iniciales de ciertos elementos se propagan de forma 'desproporcionada' en algunos casos, mientras que en otros apenas afectan a la funcionalidad del puente."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Descubiertos los mecanismos ocultos que evitan que los puentes se derrumben ante eventos catastróficos"
      }
    ],
