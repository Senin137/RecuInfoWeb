    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "La rana grande chilena, única en el mundo, habita la Tierra desde antes que se formara el continente americano, pero en menos de dos décadas podría desaparecer. ¿Por qué corre el riesgo de extinguirse?"
      }
