  {
    "@id": "https://simanw.local/recurso/noticia_404_6eee2cecfd",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un equipo internacional ha identificado el instante en que comienzan a solidificarse los primeros minerales alrededor de una estrella joven, un proceso que marca el arranque de la formación planetaria. El hallazgo, logrado con los telescopios Webb y ALMA, permite observar este fenómeno fuera del sistema solar en una etapa más temprana que nunca."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
