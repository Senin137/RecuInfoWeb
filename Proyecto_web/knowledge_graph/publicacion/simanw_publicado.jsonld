    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Ciudad Victoria, Tamaulipas. - El Gobierno de Américo Villarreal Anaya se suma al programa nacional “Mundial Social” mediante la construcción y rehabilitación de 12 canchas deportivas en distintos municipios del estado, con una inversión superior a 68 millones de pesos (MDP). Estas acciones complementan las canchas que construye el Gobierno de Méxi"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
