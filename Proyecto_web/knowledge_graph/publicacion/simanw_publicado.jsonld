  {
    "@id": "https://simanw.local/recurso/noticia_298_d94b2e5bc8",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Este nuevo método permite trabajar en espacios reducidos, no tiene disolventes, ni tampoco deja residuos entre las láminas. Además, los científicos muestran los planos de su invento en la propia publicación para que cualquier otro laboratorio pueda reproducirlo y trabajar con él."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Crean una técnica barata para escalar la producción de nanoláminas de materiales como el grafeno"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/Crean-una-tecnica-barata-para-escalar-la-produccion-de-nanolaminas-de-materiales-como-el-grafeno"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "tecnologia"
      }
