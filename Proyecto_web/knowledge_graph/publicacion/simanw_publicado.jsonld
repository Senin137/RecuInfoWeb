      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Cuando los grandes astros se quedan sin energía, sus núcleos colapsan y perecen mediante una gran explosión denominada supernova. Un estudio revela que la luz de uno de estos fenómenos cósmicos, denominado SN 2024afav, presenta modulaciones en su brillo debido a la posible presencia de una estrella de neutrones."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Una supernova emite extrañas ondulaciones de luz debido a un magnetar en su interior"
      }
    ],
