    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Las fusiones de estrellas de neutrones son una de las fuentes más prometedoras para estudiar el universo a partir de las ondas gravitacionales, pero son difíciles de detectar. Un nuevo método podría revolucionar este campo gracias a la inteligencia artificial."
      }
    ],
