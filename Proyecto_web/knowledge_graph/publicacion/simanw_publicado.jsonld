  {
    "@id": "https://simanw.local/recurso/noticia_405_049689225a",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El experimento LHCb del CERN observa por primera vez una violación de simetría materia-antimateria en bariones, un fenómeno que se predijo en los años 60 sobre el origen del universo, pero que nunca antes se había comprobado en las partículas que forman la materia común. Esto podría revelar nuevas vías hacia una física más allá del Modelo Estándar."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El CERN confirma que la materia y la antimateria no se comportan igual"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/El-CERN-confirma-que-la-materia-y-la-antimateria-no-se-comportan-igual"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "ciencia"
      }
    ],
    "https://simanw.local/ontology#escritaPor": [
      {
        "@id": "https://simanw.local/recurso/autor_antonio_villarreal"
      }
    ],
    "https://simanw.local/ontology#fechaPublicacion": [
      {
        "@value": "Wed, 16 Jul 2025 17:00:21 +0200"
      }
    ],
    "https://simanw.local/ontology#fuenteTexto": [
      {
        "@language": "es",
        "@value": "https://www.agenciasinc.es/feed/Ciencia"
      }
    ],
    "https://simanw.local/ontology#mencionaEntidad": [
      {
        "@id": "https://simanw.local/recurso/entidad_esto"
      },
      {
        "@id": "https://simanw.local/recurso/entidad_modelo_est%C3%A1ndar"
      }
    ],
    "https://simanw.local/ontology#publicadaPor": [
      {
        "@id": "https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"
      }
    ],
    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "El experimento LHCb del CERN observa por primera vez una violación de simetría materia-antimateria en bariones, un fenómeno que se predijo en los años 60 sobre el origen del universo, pero que nunca antes se había comprobado en las partículas que forman la materia común. Esto podría revelar nuevas vías hacia una física más allá del Modelo Estándar."
      }
    ],
