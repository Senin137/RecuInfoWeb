  {
    "@id": "https://simanw.local/recurso/noticia_524_7c31ffa4cf",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Templos, sepulcros, enormes anillos de monolitos. Todo eso rodeó alguna vez al famoso sitio de Stonehenge, Patrimonio de la Humanidad, según descubrieron al escanear el suelo debajo de sus enormes piedras."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Las sorpresas subterráneas que descubrieron en Stonehenge"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://www.bbc.co.uk/mundo/noticias/2014/09/140910_ciencia_stonehenge_sorpresas_enterradas_np.shtml"
      }
    ],
