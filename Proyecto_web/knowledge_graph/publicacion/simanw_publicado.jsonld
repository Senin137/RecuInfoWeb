    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un estudio evalúa la seguridad de modelos de inteligencia artificial para combatir la divulgación de información falsa o maliciosa en consultas sobre salud. Los investigadores revelan vulnerabilidades en Chat GPT- 4 y Gemini 1.5 Pro, Claude 3.5 Sonnet, Llama 3.2-90B Vision y Grok Beta."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
