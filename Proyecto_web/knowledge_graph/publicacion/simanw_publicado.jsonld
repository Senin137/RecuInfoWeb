    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Hoy me he pasado por Amazon para revisar qué ofertas merecen realmente la pena y he encontrado varias oportunidades interesantes para quienes quieren ahorrar antes del verano. Este 3 de junio, la plataforma reúne descuentos de hasta el 52% en productos muy variados, desde moda y calzado hasta cafeteras y otros básicos para el día a día.&nbsp;"
      }
