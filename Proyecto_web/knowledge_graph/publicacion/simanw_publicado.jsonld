    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Esta fina estructura se localiza a doscientos mil kilómetros bajo la superficie del astro, donde se alcanzan temperaturas superiores a dos millones de grados. Un estudio internacional emplea técnicas heliosismológicas para comprender su naturaleza y su función en la creación de tormentas solares."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
