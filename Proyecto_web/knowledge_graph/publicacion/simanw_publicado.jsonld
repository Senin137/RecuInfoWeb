    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La Agencia Espacial Europea ha contratado a la empresa Deimos Space para integrar en Puertollano (Ciudad Real) un ‘objeto contenedor de evaluación de reentrada destructiva’. Este satélite recogerá valiosas mediciones durante su reentrada y ruptura reales en la atmósfera, lo que ayudará a disponer de sistemas espaciales más desechables frente al aum"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
