    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Aunque han pasado varios años desde que abandonó 'La que se avecina', Luis Miguel Seguí sigue siendo una de las caras más recordadas de la popular comedia. El actor, que dio vida a Leo durante gran parte de la trayectoria de la serie, ha repasado algunos de los momentos más destacados de aquella etapa en una entrevista para el pódcast 'Animales Hum"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Luis Miguel dice lo que pocos se imaginan de los rodajes de 'LQSA': \"Se justificaba diciendo que así era más gracioso\""
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.mundodeportivo.com/elotromundo/television/20260602/1004190583/luis-miguel-dice-pocos-imaginan-rodajes-avecina-justificaba-diciendo-asi-mas-gracioso-dct.html"
      }
    ],
