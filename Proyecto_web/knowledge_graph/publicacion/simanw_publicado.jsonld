    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El nuevo copago farmacéutico ya está en vigor y cambia una de las reglas más importantes para quienes tienen que retirar medicamentos con receta de forma habitual.\n\nEn España, el copago es la parte del precio de los medicamentos financiados por el Sistema Nacional de Salud que pagan los usuarios cuando los retiran en la farmacia. El resto del impor"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El nuevo copago farmacéutico cambia la aportación en los medicamentos. Los trabajadores con menos de 35.000 euros tendrán un límite de 62 euros al mes"
      }
