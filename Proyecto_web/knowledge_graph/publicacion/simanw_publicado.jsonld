    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Sigue dando la vuelta al mundo el reportaje de '60 Minutes Australia' sobre la familia Cascio. En una de sus últimas entregas, cuatro hermanos denuncian haber sufrido abusos por parte de Michael Jackson. Debido a la estrecha relación que mantenía con su padre, el artista era considerado prácticamente uno más de la familia."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Marie Cascio denuncia abusos de Michael Jackson: \"Era adicto, sufría sobredosis delante de nosotros\""
      }
