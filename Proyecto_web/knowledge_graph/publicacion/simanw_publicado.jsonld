    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Es grave y millones de mujeres lo sufren, pero pueden pasar años antes de que les diagnostiquen y traten adecuadamente este trastorno que causa síntomas psicológicos graves y, en ocasiones, físicos."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "\"Es como si la muerte viniera a buscarnos cada mes\": la pesadilla de vivir con el trastorno disfórico premenstrual"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.bbc.com/mundo/articles/crkppvv103jo?at_medium=RSS&at_campaign=rss"
