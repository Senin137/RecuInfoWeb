      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La portavoz del Grupo Popular en el Congreso, Ester Muñoz, ha criticado este martes que el PSOE haya pasado de decir que no sabía quién es Leire Díez a reconocer que le pagó 45.000 euros. A su entender, en el Partido Socialista \"mienten más que hablan\"."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El PP acusa al PSOE de pasar de no saber quién es Leire Díez a admitir que le pagó 45.000 euros: \"Miente más que habla\""
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.europapress.es/nacional/noticia-pp-acusa-psoe-pasar-no-saber-quien-leire-diez-admitir-le-pago-45000-euros-miente-mas-habla-20260602191022.html"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "gobierno"
