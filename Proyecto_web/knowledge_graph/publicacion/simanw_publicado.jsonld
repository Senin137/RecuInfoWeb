    "https://simanw.local/ontology#titulo": [
      {
        "@language": "es",
        "@value": "Roberto González, propietario de tres gimnasios: \"Dependes de las personas que acuden, pero cada mes gano entre 100.000 y 180.000 euros. Este año superaremos los tres millones de facturación\""
      }
