  {
    "@id": "https://simanw.local/recurso/noticia_293_f24ecd4bb3",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "España se ha convertido en uno de los pocos países capaces de diseñar, fabricar y enviar cohetes al espacio con el lanzamiento este fin de semana desde Huelva de Miura 1, un demostrador tecnológico de la empresa PLD Space. Se han cumplido la mayoría de los objetivos, pero no se ha completado la recuperación de la nave en el océano Atlántico."
      }
    ],
