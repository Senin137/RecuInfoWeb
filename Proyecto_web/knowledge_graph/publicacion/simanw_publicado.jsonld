    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Para robarla tienes que romperla. Así de simple pero innovador es el concepto de la bicicleta-candado, diseñada por tres estudiantes chilenos que pasaron por la experiencia de perder sus queridos velocípedos."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "La bicicleta chilena antirrobo que nació de un mal recuerdo"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://www.bbc.co.uk/mundo/noticias/2014/08/140825_tecnologia_bicicleta_chilena_antirobo_ig.shtml"
      }
