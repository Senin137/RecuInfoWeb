    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Gracias a la instalación STARDUST, un equipo de investigadores ha podido reproducir las condiciones atmosféricas de este tipo de estrellas en un laboratorio y comprender la función que desempeña el hidrógeno en la formación del polvo estelar en estos cuerpos celestes."
      }
    ],
