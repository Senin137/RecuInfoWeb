    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un nuevo análisis refuta que Nereida, una de las 16 lunas de Neptuno, fuese tomada desde fuera de la órbita del planeta como el resto de satélites. Según los resultados, su composición es diferente a la de otros objetos del cinturón de Kuiper, lo que la convertiría en el único resto del sistema original de lunas."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Nereida podría ser una de las lunas originales de Neptuno, y no una captura del cinturón de Kuiper"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
