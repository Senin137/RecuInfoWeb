    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un equipo internacional de astrónomos ha identificado, gracias a observaciones combinadas del telescopio espacial James Webb y de varios observatorios terrestres, un exoplaneta con un océano global de magma y una atmósfera saturada de compuestos de azufre. Sus rasgos extremos revelan un tipo de mundo que no encaja en las categorías conocidas."
      }
    ],
