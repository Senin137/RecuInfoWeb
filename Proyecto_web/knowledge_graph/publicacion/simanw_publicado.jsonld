    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un nuevo estudio internacional con participación española vuelve a poner bajo el microscopio a una de las partículas más escurridizas del cosmos. Aunque durante años se ha planteado la posibilidad de un cuarto tipo de neutrino capaz de explicar ciertas anomalías, los últimos resultados reducen aún más el margen para su existencia."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
