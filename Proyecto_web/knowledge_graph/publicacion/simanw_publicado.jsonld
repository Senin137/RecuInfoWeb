  {
    "@id": "https://simanw.local/recurso/noticia_455_f822b3499b",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La música puede escucharse comúnmente en los quirófanos. Se ha demostrado que la música disminuye el estrés del equipo quirúrgico y reduce la ansiedad del paciente antes de la cirugía. \n\nPor otro lado, se ha revelado que la música puede generar efectos negativos de atención dividida que causan distracción en las rutinas quirúrgicas, tal y como sugi"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "La música ayuda a que las operaciones de cirugía se hagan mejor (y también sirve para saber si se opera bien un tumor)"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
