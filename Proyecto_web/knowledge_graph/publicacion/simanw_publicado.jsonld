    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Faltan pocos días para el inicio de la Copa Mundial de fútbol y los países organizadores, Estados Unidos, México y Canadá, se preparan para recibir a las selecciones de todo el mundo que participarán en el torneo. Con la confirmación de las convocatorias, equipos como Brasil ya aterrizaron en Estados Unidos, mientras que a algunos jugadores y selec"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
