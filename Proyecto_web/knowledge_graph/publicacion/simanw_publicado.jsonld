  {
    "@id": "https://simanw.local/recurso/noticia_392_1ff8882944",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "¿Podrá aterrizar Hayabusa2? Un equipo de astrónomos y astrónomas ha utilizado observatorios de todo el mundo, incluido el Very Large Telescope del Observatorio Europeo Austral (VLT de ESO), para estudiar el asteroide 1998 KY26, revelando que es casi tres veces más pequeño y gira mucho más rápido de lo que se pensaba."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Hayabusa2 se enfrenta a un asteroide más pequeño y veloz de lo esperado"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/Hayabusa2-se-enfrenta-a-un-asteroide-mas-pequeno-y-veloz-de-lo-esperado"
