  {
    "@id": "https://simanw.local/recurso/noticia_1286_08ecbb4577",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Es una de las marcas más influyentes del siglo XX. Triunfó y cayó varias veces y hoy está conquistando una vez más a nuevas generaciones. Esta es la historia de Gap."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Donald y Doris Fisher, la pareja que no pudo encontrar un talle de jeans y terminó creando el gigante de la moda Gap"
