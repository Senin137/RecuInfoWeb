    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Rusia bombardeó Ucrania con cientos de drones y decenas de misiles la madrugada del martes, matando a 23 personas e hiriendo a 130."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
