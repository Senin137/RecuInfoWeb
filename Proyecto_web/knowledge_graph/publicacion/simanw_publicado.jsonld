    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Las remesas hacia México sumaron 4 mil 978 millones de dólares en abril, un aumento de 3.7 por ciento respecto al mismo mes del año pasado, y si bien se ha reducido el número total de envíos, cada transferencia es por una mayor cantidad de dinero, reportó el Banco de México (BdeM)."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
