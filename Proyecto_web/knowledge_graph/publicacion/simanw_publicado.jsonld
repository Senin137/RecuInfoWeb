    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un equipo del Instituto de Microelectrónica de Barcelona del CSIC ha desarrollado el prototipo de una nueva celda de conmutación para vehículo eléctrico que permitirá adaptar y controlar los flujos de potencia entre las fuentes de energía y sus cargas de un modo más eficiente, como entre la batería y el motor."
      }
    ],
