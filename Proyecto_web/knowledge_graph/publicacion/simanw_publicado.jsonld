  {
    "@id": "https://simanw.local/recurso/noticia_449_8aa5a5da39",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Las fusiones de estrellas de neutrones son una de las fuentes más prometedoras para estudiar el universo a partir de las ondas gravitacionales, pero son difíciles de detectar. Un nuevo método podría revolucionar este campo gracias a la inteligencia artificial."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "IA para detectar en un segundo nuevas fuentes de ondas gravitacionales"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/IA-para-detectar-en-un-segundo-nuevas-fuentes-de-ondas-gravitacionales"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "ciencia"
      }
    ],
    "https://simanw.local/ontology#escritaPor": [
      {
        "@id": "https://simanw.local/recurso/autor_antonio_villarreal"
