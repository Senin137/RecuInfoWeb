    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Una observación clave permite profundizar en la fuerza que mantiene unidos los componentes del núcleo atómico y en la estructura de la materia. La partícula descubierta, formada por dos quarks charm y un quark down, tiene una masa cuatro veces superior a la de un protón."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
