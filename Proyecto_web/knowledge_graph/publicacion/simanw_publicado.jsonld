    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La deuda pública de México se mantiene bajo control y alineada con la capacidad de pago del país, aseguró la Secretaría de Hacienda y Crédito Público (SHCP), y destacó que su sostenibilidad debe analizarse en relación con el tamaño de la economía, su composición, el costo financiero, plazo promedio y perfil de vencimientos."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
