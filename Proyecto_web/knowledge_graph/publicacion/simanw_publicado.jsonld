    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Los delitos e incidentes de odio se han incrementado un 23,6% en 2025, registrando la mayor cifra de la serie histórica según el informe anual del Ministerio del Interior, que destaca también el aumento de la participación de los menores en este tipo de delitos, tanto en calidad de víctimas (+17%) como autores (+19%)."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Los delitos de odio marcan máximo histórico al subir un 23,6% en 2025 y aumenta la participación de menores"
      }
    ],
