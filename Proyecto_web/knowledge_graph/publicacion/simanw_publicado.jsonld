    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "El Instituto de Astrofísica de Andalucía (IAA-CSIC) ha obtenido imágenes que revelan la estructura interna de un ‘jet’ expulsado por una estrella joven y su interacción con el entorno. El hallazgo permite confirmar por primera vez un modelo teórico planteado hace tres décadas sobre la dinámica de los jets estelares."
      }
    ],
