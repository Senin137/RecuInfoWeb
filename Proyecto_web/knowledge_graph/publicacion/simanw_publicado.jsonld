  {
    "@id": "https://simanw.local/recurso/noticia_11_85ab000dca",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Una mole de acero de 25.000 toneladas, con la superficie de un campo de fútbol y la altura de un edificio de 15 plantas, surca ahora mismo el océano a bordo de un inmenso buque semisumergible. El último gran hito de la ingeniería asiática ya está en marcha. Este coloso acaba de zarpar desde el puerto de Nantong, en la provincia oriental de Jiangsu,"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Llevar la energía eólica a 100 km de la costa parecía imposible. Hasta que China ha botado su nuevo \"corazón\" metálico"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.xataka.com/energia/gran-problema-eolica-era-alejarse-costa-china-acaba-solucionarlo-monstruo-acero-25-000-toneladas"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
