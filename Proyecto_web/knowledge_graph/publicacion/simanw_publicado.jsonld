  {
    "@id": "https://simanw.local/recurso/noticia_212_c2090fd963",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un equipo de investigación de Reino Unido ha transformado una bacteria para que produzca este analgésico y antipirético a partir del plástico de botellas desechadas. Este proceso no emite gases de efecto invernadero y su producción resulta más sostenible que la habitual, que utiliza combustibles fósiles."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Una bacteria es capaz de convertir botellas de plástico en paracetamol"
      }
    ],
