    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "Es grave y millones de mujeres lo sufren, pero pueden pasar años antes de que les diagnostiquen y traten adecuadamente este trastorno que causa síntomas psicológicos graves y, en ocasiones, físicos."
      }
