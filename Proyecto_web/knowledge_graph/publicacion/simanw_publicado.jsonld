    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un equipo del Instituto de Astrofísica de Andalucía y de la Universidad de Tokio ha revelado que una tormenta de polvo local impulsó vapor de agua hasta 80 kilómetros de altura en pleno verano boreal, un comportamiento no previsto por los modelos climáticos y capaz de incrementar de forma significativa el escape de hidrógeno al espacio."
      }
    ],
