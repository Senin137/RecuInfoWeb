      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El PSOE ha reconocido que pagó 44.859 euros a Leire Díez como asesora de comunicación del partido en Cantabria entre 2015 y 2017, frente a los 15.612 euros que ya había admitido ante el juez de Plaza de Castilla que investiga a la exmilitante socialista por presuntos delitos de tráfico de influencias y cohecho."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "El PSOE eleva a casi 45.000 euros los pagos a Leire Díez como asesora de comunicación en Cantabria en 2015 y 2017"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.europapress.es/nacional/noticia-psoe-eleva-casi-45000-euros-pagos-leire-diez-asesora-comunicacion-cantabria-2015-2017-20260602150110.html"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
