    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Mañana comienza una sucesión de eventos astronómicos inusuales, con un eclipse total de Luna visible en gran parte del mundo. A este fenómeno le seguirán la alineación de cuatro planetas, el equinoccio de primavera y un eclipse parcial de Sol el día 29. Además, en los próximos años se encadenarán varios eclipses destacados en España."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
