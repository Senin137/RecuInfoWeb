    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La estrella WISPIT 2 muestra un entorno dinámico y complejo que revela cómo nacen los sistemas planetarios. Nuevas observaciones de ESO han confirmado la presencia de dos mundos en formación en su disco, un hallazgo excepcional para comprender nuestro propio origen cósmico."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "¿Un sistema solar naciente? Observan dos planetas en formación en torno a una estrella joven"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.agenciasinc.es/esl/Noticias/Un-sistema-solar-naciente-Observan-dos-planetas-en-formacion-en-torno-a-una-estrella-joven"
      }
    ],
