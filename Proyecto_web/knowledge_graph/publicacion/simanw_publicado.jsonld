    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Tal y como se rumoreaba, Microsoft ha aprovechado la keynote inaugural de su conferencia Build para introducir su primer modelo de razonamiento de desarrollo propio. Se trata de MAI-Thinking-1, que destaca especialmente por sus capacidades vinculadas con la matemática y la programación. Los de Redmond definen a MAI-Thinking-1 como un modelo de tama"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Microsoft lanza MAI-Thinking-1, su primera IA de razonamiento avanzado de desarrollo propio"
