    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Un estudio propone que los seres vivos tienen la capacidad de computar de manera subatómica y procesar información en una millonésima de microsegundo. Este hallazgo puede ayudar al desarrollo de equipos cuánticos más autónomos y resilientes."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
