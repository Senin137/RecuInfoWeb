  {
    "@id": "https://simanw.local/recurso/noticia_254_bdafac14ba",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "La velocidad se incrementa a medida que el futbolista se acerca al balón, sin embargo, disminuye ligeramente al llegar a él. Los delanteros son los que corren más directamente hacia el esférico, mientras que los porteros lo hacen de una forma más paralela. Son algunos resultados de un estudio de investigadores españoles."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Así cambia la velocidad y ángulos en los jugadores de fútbol"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
