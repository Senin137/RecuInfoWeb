    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Gracias a datos infrarrojos, un nuevo estudio en Science revela el descubrimiento de una estrella que, al morir, colapsa directamente a agujero negro sin explotar. El hallazgo demuestra que estos procesos, tan difíciles de detectar, podrían ser mucho más comunes de lo esperado."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
