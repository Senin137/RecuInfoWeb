  {
    "@id": "https://simanw.local/recurso/noticia_1217_39ccd07129",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Hay ascensiones al Everest que se miden en metros de desnivel, en horas de esfuerzo o en cifras de oxígeno consumido. Y luego están las que trascienden cualquier estadística para convertirse en una lección de vida. La protagonizada por Rustam Nabiev, alpinista ruso de 34 años, pertenece a esta última categoría."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "La increíble gesta de Rustam Nabiev, un amputado sin piernas en la cima del Everest"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
