  {
    "@id": "https://simanw.local/recurso/noticia_1104_eac6cf5984",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "El futuro de Willy Hernangómez y el Barça no parece ir de la mano. El pívot madrileño, de 32 años recién cumplidos, quedará libre tras finalizar el presente curso y no continuará defendiendo la elástica del club catalán. Willy no ha recibido la oferta de renovación del Barça y pondrá fin a una etapa de tres temporadas en el Palau Blaugrana."
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Willy ya tendría equipo para la próxima temporada: acuerdo \"muy avanzado\""
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://www.mundodeportivo.com/baloncesto/acb/20260603/1004190742/willy-hernangomez-tendria-equipo-proxima-temporada-acuerdo-avanzado.html"
      }
    ],
    "https://simanw.local/ontology#categoriaTexto": [
      {
        "@language": "es",
        "@value": "deportes"
      }
    ],
    "https://simanw.local/ontology#escritaPor": [
