    "https://simanw.local/ontology#resumen": [
      {
        "@language": "es",
        "@value": "No. Luis de la Fuente no será el entrenador del Real Madrid si el empresario alicantino Enrique Riquelme sale elegido en las elecciones a la presidencia del club blanco el próximo domingo día 7. Eso fue lo que aseguró el propio seleccionador nacional ayer por la noche durante una extensa entrevista en el programa 'El Larguero' (SER), con Manu Carre"
      }
    ],
