  {
    "@id": "https://simanw.local/recurso/noticia_468_68305007d4",
    "@type": [
      "https://schema.org/NewsArticle",
      "https://simanw.local/ontology#Noticia"
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "es",
        "@value": "Por cuarto año consecutivo, el próximo sábado  22 de noviembre celebraremos otra de nuestras grandes apuestas del año: Naukas Palma, 360º de ciencia. Como siempre, será en el Palacio de Congresos de Palma y la entrada será gratuita hasta completar el aforo. Aquí os dejamos el programa definitivo del evento, que organizamos junto a la  Universitat d"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@language": "es",
        "@value": "Ya tenemos programa definitivo de Naukas Palma 2025"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "https://naukas.com/2025/11/11/ya-tenemos-programa-definitivo-de-naukas-palma-2025/"
