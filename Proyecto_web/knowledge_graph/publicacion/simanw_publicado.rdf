    <simanw:tokensClave xml:lang="es">huracán, helene, generó, gigantescas, olas, gravedad, atmosféricas, clima, terrestre, afectar, espacial, pasado, septiembre, experimento, ondas</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/El-huracan-Helene-genero-gigantescas-olas-de-gravedad-atmosfericas"/>
