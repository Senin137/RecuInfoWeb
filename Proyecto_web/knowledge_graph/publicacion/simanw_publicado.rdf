  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_1262_5100f3f5a9">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El abogado Abelardo de la Espriella y el senador Iván Cepeda se disputarán la presidencia de Colombia en el balotaje del 21 de junio, en el que los colombianos elegirán al sucesor de Gustavo Petro. El presidente dijo que no acepta "los resultados del preconteo".</dc:description>
    <dc:title xml:lang="es">Así te lo contamos: De la Espriella y Cepeda pelearán por la presidencia de Colombia en segunda vuelta</dc:title>
    <dcterms:identifier>https://www.bbc.co.uk/mundo/live/c62r12yy04xt?at_medium=RSS&amp;at_campaign=rss</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">deportes</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>Wed, 03 Jun 2026 02:33:35 +0000</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://feeds.bbci.co.uk/mundo/topics/cdr56g57ywgt/rss.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_abelardo"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_cepeda"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_colombia"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_espriella"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_iv%C3%A1n_cepeda"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_feeds_bbci_co_uk_mundo_topics_cdr56g57ywgt_rss_xml"/>
    <simanw:resumen xml:lang="es">El abogado Abelardo de la Espriella y el senador Iván Cepeda se disputarán la presidencia de Colombia en el balotaje del 21 de junio, en el que los colombianos elegirán al sucesor de Gustavo Petro. El presidente dijo que no acepta "los resultados del preconteo".</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.296</simanw:sentimientoScore>
