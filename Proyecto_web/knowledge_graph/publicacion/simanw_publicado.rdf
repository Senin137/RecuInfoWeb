    <simanw:fechaPublicacion>Mon, 12 Jan 2026 11:00:05 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_descubren"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_observatorio_europeo_austral"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_very_large_telescope"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Una estructura inesperada rodea a una enana blanca y desconcierta a la comunidad científica. El descubrimiento, realizado gracias al Very Large Telescope del Observatorio Europeo Austral, desafía los modelos actuales sobre la interacción de las estrellas muertas con su entorno.</simanw:resumen>
