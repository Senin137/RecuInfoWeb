    <simanw:tokensClave xml:lang="es">misión, polaris, dawn, intentará, semana, primera, caminata, espacial, privada, cápsula, dragon, spacex, despegó, martes, comandada</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/La-mision-Polaris-Dawn-intentara-esta-semana-la-primera-caminata-espacial-privada"/>
