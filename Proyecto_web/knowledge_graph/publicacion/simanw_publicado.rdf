  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_254_bdafac14ba">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La velocidad se incrementa a medida que el futbolista se acerca al balón, sin embargo, disminuye ligeramente al llegar a él. Los delanteros son los que corren más directamente hacia el esférico, mientras que los porteros lo hacen de una forma más paralela. Son algunos resultados de un estudio de investigadores españoles.</dc:description>
    <dc:title xml:lang="es">Así cambia la velocidad y ángulos en los jugadores de fútbol</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Asi-cambia-la-velocidad-y-angulos-en-los-jugadores-de-futbol</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Tue, 11 Jun 2024 13:30:03 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">La velocidad se incrementa a medida que el futbolista se acerca al balón, sin embargo, disminuye ligeramente al llegar a él. Los delanteros son los que corren más directamente hacia el esférico, mientras que los porteros lo hacen de una forma más paralela. Son algunos resultados de un estudio de investigadores españoles.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.5574</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">Así cambia la velocidad y ángulos en los jugadores de fútbol</simanw:titulo>
    <simanw:tokensClave xml:lang="es">cambia, velocidad, ángulos, jugadores, fútbol, velocidad, incrementa, medida, futbolista, acerca, balón, embargo, disminuye, ligeramente, llegar</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Asi-cambia-la-velocidad-y-angulos-en-los-jugadores-de-futbol"/>
