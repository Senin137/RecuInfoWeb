  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_270_6d6cb319d8">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Hasta ahora el récord de permanencia en el espacio, sumando diversas misiones, lo ostentaba el ruso Guennadi Padalka con 878 días, pero este fin de semana su compatriota Oleg Kononenko ha superado ese tiempo durante su estancia en la Estación Espacial Internacional. Cuando regrese a la Tierra en septiembre dejará la marca en 1.110 días.</dc:description>
    <dc:title xml:lang="es">El cosmonauta Oleg Kononenko establece un nuevo récord mundial de estancia en el espacio</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-cosmonauta-Oleg-Kononenko-establece-un-nuevo-record-mundial-de-estancia-en-el-espacio</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Mon, 05 Feb 2024 12:16:18 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_cuando"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_estaci%C3%B3n_espacial_internacional"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_guennadi_padalka"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_hasta"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_oleg_kononenko"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Hasta ahora el récord de permanencia en el espacio, sumando diversas misiones, lo ostentaba el ruso Guennadi Padalka con 878 días, pero este fin de semana su compatriota Oleg Kononenko ha superado ese tiempo durante su estancia en la Estación Espacial Internacional. Cuando regrese a la Tierra en septiembre dejará la marca en 1.110 días.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">El cosmonauta Oleg Kononenko establece un nuevo récord mundial de estancia en el espacio</simanw:titulo>
    <simanw:tokensClave xml:lang="es">cosmonauta, oleg, kononenko, establece, nuevo, récord, mundial, estancia, espacio, récord, permanencia, espacio, sumando, diversas, misiones</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/El-cosmonauta-Oleg-Kononenko-establece-un-nuevo-record-mundial-de-estancia-en-el-espacio"/>
  </rdf:Description>
