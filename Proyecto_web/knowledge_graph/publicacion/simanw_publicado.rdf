  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_284_e496e00666">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Tras la explosión del pasado mes de abril, este sábado está previsto que la compañía SpaceX lance desde Texas (EE UU) el cohete más potente que ha volado nunca. La NASA y otras agencias espaciales estarán muy pendientes de este vuelo de prueba, ya que es la nave que llevará astronautas en próximas misiones a la Luna.</dc:description>
    <dc:title xml:lang="es">Nuevo lanzamiento del supercohete de Starship</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Nuevo-lanzamiento-del-supercohete-de-Starship</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc_efe"/>
    <simanw:fechaPublicacion>Fri, 17 Nov 2023 09:16:11 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_luna"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_nuevo"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_space"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_starship_tras"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_texas"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Tras la explosión del pasado mes de abril, este sábado está previsto que la compañía SpaceX lance desde Texas (EE UU) el cohete más potente que ha volado nunca. La NASA y otras agencias espaciales estarán muy pendientes de este vuelo de prueba, ya que es la nave que llevará astronautas en próximas misiones a la Luna.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
