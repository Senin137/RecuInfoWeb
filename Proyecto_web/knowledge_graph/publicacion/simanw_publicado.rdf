    <simanw:fechaPublicacion>Tue, 02 Jun 2026 08:32:37 GMT</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.jornada.com.mx/rss/politica.xml?v=1</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_comisi%C3%B3n_temporal"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_instalan_comisi%C3%B3n_temporal"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_instituto_nacional_electoral"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_presupuesto"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_rita_bell_l%C3%B3pez"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_jornada_com_mx_rss_politica_xml_v_1"/>
    <simanw:resumen xml:lang="es">Al instalar la Comisión Temporal de Presupuesto 2027 del Instituto Nacional Electoral (INE), la consejera Rita Bell López manifestó su preocupación por la serie de renuncias que se han solicitado a funcionarios de carrera, quienes llevaban años en el órgano electoral y ahora están a la espera del pago pendiente de sus prestaciones.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
