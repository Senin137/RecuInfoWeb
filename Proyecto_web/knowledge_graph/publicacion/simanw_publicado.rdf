  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_248_ab3436273e">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Tras desacoplarse de la Estación Espacial Internacional, la cápsula de Boeing aterrizó vacía este fin de semana en un desierto de Nuevo México (EE UU). Inicialmente estaba previsto que regresaran en ella los astronautas Butch Wilmore y Suni Williams de la NASA pero, debido a sus fallos técnicos, esperarán hasta febrero en el complejo orbital.</dc:description>
    <dc:title xml:lang="es">La nave Starliner vuelve a la Tierra sin sus dos tripulantes</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/La-nave-Starliner-vuelve-a-la-Tierra-sin-sus-dos-tripulantes</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc_efe"/>
    <simanw:fechaPublicacion>Mon, 09 Sep 2024 11:08:21 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_boeing"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_estaci%C3%B3n_espacial_internacional"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_starliner"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tras"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Tras desacoplarse de la Estación Espacial Internacional, la cápsula de Boeing aterrizó vacía este fin de semana en un desierto de Nuevo México (EE UU). Inicialmente estaba previsto que regresaran en ella los astronautas Butch Wilmore y Suni Williams de la NASA pero, debido a sus fallos técnicos, esperarán hasta febrero en el complejo orbital.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.5574</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
