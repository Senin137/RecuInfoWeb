    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El Instituto de Tecnología Química coordina el proyecto europeo hyPPER, un nuevo reactor que almacena y transporta energía eléctrica renovable mediante moléculas orgánicas portadoras de hidrógeno. La tecnología se integraría de manera más eficaz en plantas de energía renovable existentes.</dc:description>
    <dc:title xml:lang="es">Crean un sistema para almacenar energía renovable mediante moléculas orgánicas</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Crean-un-sistema-para-almacenar-energia-renovable-mediante-moleculas-organicas</dcterms:identifier>
