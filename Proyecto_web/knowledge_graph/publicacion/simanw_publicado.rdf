    <simanw:fechaPublicacion>Tue, 02 Jun 2026 08:32:37 GMT</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.jornada.com.mx/rss/economia.xml?v=1</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_banco"/>
