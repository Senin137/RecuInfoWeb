    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_tecnologia_index_xml"/>
    <simanw:resumen xml:lang="es">En Europa circula la idea de lograr una "economía circular", en la que los desechos se reciclan y vuelven ser productivos. El oro que contienen los teléfonos está en la mira pero ¿cuánto de la demanda pueden satisfacer?</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
