  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_334_89d36ea439">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El hallazgo de moléculas orgánicas presentes en el ADN y ARN terrestres en un objeto espacial permite entender la forma en la que se generan estos compuestos en entornos inhóspitos. Su descubrimiento refuerza la hipótesis de que los asteroides carbonáceos contribuyeron al inventario químico de la Tierra primitiva.</dc:description>
    <dc:title xml:lang="es">El asteroide Ryugu contiene cinco componentes esenciales de la vida en la Tierra</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-asteroide-Ryugu-contiene-cinco-componentes-esenciales-de-la-vida-en-la-Tierra</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
