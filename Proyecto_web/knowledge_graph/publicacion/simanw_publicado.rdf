    <simanw:fechaPublicacion>Mon, 01 Jun 2026 10:45:06 GMT</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://feeds.bbci.co.uk/mundo/topics/cdr56g57ywgt/rss.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_abelardo"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_c%C3%B3mo"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_colombia_abelardo"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_espriella"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_trump"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_feeds_bbci_co_uk_mundo_topics_cdr56g57ywgt_rss_xml"/>
    <simanw:resumen xml:lang="es">Abelardo de la Espriella, un abogado polémico que imita las estrategias de Trump, Bukele o Milei representa una derecha distinta a la que gobernó Colombia por décadas. Él, sin embargo, dice que es más uribista que Álvaro Uribe. Perfil en clave histórica.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.5574</simanw:sentimientoScore>
