  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_190_564ee5de53">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un equipo de investigadores de la Universidad Politécnica de Madrid demuestra que el aprendizaje por refuerzo −una rama de la inteligencia artificial− permite a drones autónomos interceptar de forma segura otros drones no autorizados, incluso en condiciones adversas y ante maniobras impredecibles.</dc:description>
    <dc:title xml:lang="es">La IA permite interceptar drones no autorizados en el espacio aéreo</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/La-IA-permite-interceptar-drones-no-autorizados-en-el-espacio-aereo</dcterms:identifier>
