    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_windows_live_messenger"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_tecnologia_index_xml"/>
    <simanw:resumen xml:lang="es">La desconexión del emblemático programa de Microsoft en China supone la desaparición definitiva de un servicio que fue pionero en la comunicación instantánea en internet.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
