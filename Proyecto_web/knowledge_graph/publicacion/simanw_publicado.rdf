  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_978_0ff4b357f7">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La presidenta acusó a sectores de la oposición de buscar injerencia de Washington en México. Criticó a la gobernadora panista de Chihuahua por impedir la manifestación de Morena y le exigió "congruencia".</dc:description>
