    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:relacionadaConDataset rdf:resource="https://simanw.local/recurso/dataset_emisiones_clima_mx"/>
    <simanw:resumen xml:lang="es">Un nuevo estudio señala que la luz artificial altera los ciclos naturales de las plantas. En promedio, las que están en ciudades inician su crecimiento 12 días antes y lo prolongan 11 días más que en zonas rurales.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
