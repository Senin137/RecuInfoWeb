    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">Hayabusa2 se enfrenta a un asteroide más pequeño y veloz de lo esperado</simanw:titulo>
    <simanw:tokensClave xml:lang="es">hayabusa, enfrenta, asteroide, pequeño, veloz, esperado, podrá, aterrizar, hayabusa, equipo, astrónomos, astrónomas, utilizado, observatorios, mundo</simanw:tokensClave>
