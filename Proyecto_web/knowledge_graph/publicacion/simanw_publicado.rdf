  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_242_0e9a540e68">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un equipo del Instituto de Microelectrónica de Barcelona del CSIC ha desarrollado el prototipo de una nueva celda de conmutación para vehículo eléctrico que permitirá adaptar y controlar los flujos de potencia entre las fuentes de energía y sus cargas de un modo más eficiente, como entre la batería y el motor.</dc:description>
