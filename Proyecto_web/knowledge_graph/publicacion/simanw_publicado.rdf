  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_346_f9305f12a0">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Gracias a datos infrarrojos, un nuevo estudio en Science revela el descubrimiento de una estrella que, al morir, colapsa directamente a agujero negro sin explotar. El hallazgo demuestra que estos procesos, tan difíciles de detectar, podrían ser mucho más comunes de lo esperado.</dc:description>
    <dc:title xml:lang="es">Captan una estrella moribunda que forma un agujero negro sin pasar por la explosión de supernova</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Captan-una-estrella-moribunda-que-forma-un-agujero-negro-sin-pasar-por-la-explosion-de-supernova</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_mar%C3%ADa_g_dionis"/>
    <simanw:fechaPublicacion>Fri, 13 Feb 2026 08:00:32 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_captan"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_gracias"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_science"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Gracias a datos infrarrojos, un nuevo estudio en Science revela el descubrimiento de una estrella que, al morir, colapsa directamente a agujero negro sin explotar. El hallazgo demuestra que estos procesos, tan difíciles de detectar, podrían ser mucho más comunes de lo esperado.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.802</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">Captan una estrella moribunda que forma un agujero negro sin pasar por la explosión de supernova</simanw:titulo>
    <simanw:tokensClave xml:lang="es">captan, estrella, moribunda, forma, agujero, negro, pasar, explosión, supernova, gracias, datos, infrarrojos, nuevo, estudio, science</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Captan-una-estrella-moribunda-que-forma-un-agujero-negro-sin-pasar-por-la-explosion-de-supernova"/>
  </rdf:Description>
