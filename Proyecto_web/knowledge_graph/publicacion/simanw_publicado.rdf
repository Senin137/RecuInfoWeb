  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_335_26b41443f9">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un equipo internacional de astrónomos ha identificado, gracias a observaciones combinadas del telescopio espacial James Webb y de varios observatorios terrestres, un exoplaneta con un océano global de magma y una atmósfera saturada de compuestos de azufre. Sus rasgos extremos revelan un tipo de mundo que no encaja en las categorías conocidas.</dc:description>
    <dc:title xml:lang="es">Detectan un planeta con características químicas y geológicas inéditas en la Vía Láctea</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Detectan-un-planeta-con-caracteristicas-quimicas-y-geologicas-ineditas-en-la-Via-Lactea</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Mon, 16 Mar 2026 13:44:09 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_detectan"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_james_webb"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_v%C3%ADa_l%C3%A1ctea_un"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un equipo internacional de astrónomos ha identificado, gracias a observaciones combinadas del telescopio espacial James Webb y de varios observatorios terrestres, un exoplaneta con un océano global de magma y una atmósfera saturada de compuestos de azufre. Sus rasgos extremos revelan un tipo de mundo que no encaja en las categorías conocidas.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0516</simanw:sentimientoScore>
