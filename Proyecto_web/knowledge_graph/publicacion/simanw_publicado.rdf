  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_347_ed53aa2439">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Después de un siglo sin poder ver este tipo de fenómenos en la Península Ibérica, el 12 de agosto se podrá ver un ocultamiento total del Sol por la Luna. Dos expertos explican la naturaleza de los eclipses solares y cómo observarlos.</dc:description>
    <dc:title xml:lang="es">Eclipse solar total: qué es lo que viviremos segundo a segundo</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Opinion/Eclipse-solar-total-que-es-lo-que-viviremos-segundo-a-segundo</dcterms:identifier>
