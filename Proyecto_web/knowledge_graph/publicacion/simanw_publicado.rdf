    <simanw:tokensClave xml:lang="es">nuevo, lanzamiento, supercohete, starship, tras, explosión, pasado, mes, abril, sábado, previsto, compañía, spacex, lance, texas</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Nuevo-lanzamiento-del-supercohete-de-Starship"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_491_8f99efe617">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El agujero negro posee una masa de de 21 millones de soles -es cinco veces mayor que el del centro de la Vía Láctea- y fue descubierto en una galaxia enana conocida como M60-UCD1.</dc:description>
    <dc:title xml:lang="es">Astrónomos descubren enorme agujero negro en pequeña galaxia</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/ultimas_noticias/2014/09/140917_ultnot_astronomos_agujero_negro_en.shtml</dcterms:identifier>
