  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_344_997ad01a3a">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un equipo investigador ha calculado la contaminación por litio en la atmósfera alta tras la entrada de un cohete Falcon 9. Estos datos, hasta ahora difíciles de detectar, son esenciales para considerar el impacto en el clima de estos procesos.</dc:description>
    <dc:title xml:lang="es">Miden por primera vez la contaminación atmosférica por la reentrada de un cohete</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Miden-por-primera-vez-la-contaminacion-atmosferica-por-la-reentrada-de-un-cohete</dcterms:identifier>
