  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_202_0d7856750c">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El proyecto utilizará el supercomputador MareNostrum 5 para probar protocolos de cómputo urgente y responder de forma inmediata a emergencias como terremotos, tsunamis o erupciones volcánicas. En el experimento de este 19 de septiembre, el sistema generará mapas de simulación sísmica que abarcarán la mitad del territorio mexicano.</dc:description>
    <dc:title xml:lang="es">El Barcelona Supercomputing Center ensaya una respuesta a terremotos en México</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-Barcelona-Supercomputing-Center-ensaya-una-respuesta-a-terremotos-en-Mexico</dcterms:identifier>
