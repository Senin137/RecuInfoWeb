  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_314_9fac24a50f">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Una colaboración internacional ha obtenido con una precisión cercana al 1 % la tasa de expansión actual del universo o constante de Hubble. Según los resultados, se expande a 73,5 kilómetros por segundo, por cada megapársec de distancia.</dc:description>
    <dc:title xml:lang="es">Miden la tasa de expansión del universo con una precisión única</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Miden-la-tasa-de-expansion-del-universo-con-una-precision-unica</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Mon, 13 Apr 2026 08:00:59 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_hubble"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_miden"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_seg%C3%BAn"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Una colaboración internacional ha obtenido con una precisión cercana al 1 % la tasa de expansión actual del universo o constante de Hubble. Según los resultados, se expande a 73,5 kilómetros por segundo, por cada megapársec de distancia.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">Miden la tasa de expansión del universo con una precisión única</simanw:titulo>
    <simanw:tokensClave xml:lang="es">miden, tasa, expansión, universo, precisión, única, colaboración, internacional, obtenido, precisión, cercana, tasa, expansión, actual, universo</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Miden-la-tasa-de-expansion-del-universo-con-una-precision-unica"/>
