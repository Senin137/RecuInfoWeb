  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_181_1f817b484c">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El 28 de abril de 2025 quedará recordado como el día que se produjo un gran apagón en España. Un año después, se conoce que la causa fueron una combinación de factores técnicos y desconexiones en cascada, y se siguen tomando medidas para que no vuelva a ocurrir.</dc:description>
    <dc:title xml:lang="es">Apagón ibérico, año 1: de la caída del sistema eléctrico a su costoso refuerzo</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Opinion/Apagon-iberico-ano-1-de-la-caida-del-sistema-electrico-a-su-costoso-refuerzo</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_fernando_de_llano_paz"/>
    <simanw:fechaPublicacion>Tue, 28 Apr 2026 09:17:22 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_apag%C3%B3n"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_espa%C3%B1a"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">El 28 de abril de 2025 quedará recordado como el día que se produjo un gran apagón en España. Un año después, se conoce que la causa fueron una combinación de factores técnicos y desconexiones en cascada, y se siguen tomando medidas para que no vuelva a ocurrir.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.296</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
