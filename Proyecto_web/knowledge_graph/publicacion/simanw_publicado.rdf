    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">"¿Si me sorprende no tener más futbolistas que seleccionar del Real Madrid? No"</simanw:titulo>
