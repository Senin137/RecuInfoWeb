    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_autor_redacci%C3%B3n"/>
    <simanw:fechaPublicacion>02 Jun 2026 18:13:41 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.mundodeportivo.com/rss/home.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_girona"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_marrakech"/>
