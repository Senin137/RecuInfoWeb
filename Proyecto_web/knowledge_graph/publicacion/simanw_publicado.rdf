  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_400_da72ea5123">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Una estrella que desafía las reglas conocidas de la evolución estelar ha sido identificada gracias a la sensibilidad ultravioleta del telescopio espacial Hubble. Su composición superficial revela una historia violenta: la unión de dos astros que, al colisionar, dieron lugar a una enana blanca con características únicas.</dc:description>
    <dc:title xml:lang="es">El Hubble revela las secuelas de una extraña colisión entre estrellas</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-Hubble-revela-las-secuelas-de-una-extrana-colision-entre-estrellas</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Thu, 07 Aug 2025 10:31:53 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_el_hubble"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_hubble"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Una estrella que desafía las reglas conocidas de la evolución estelar ha sido identificada gracias a la sensibilidad ultravioleta del telescopio espacial Hubble. Su composición superficial revela una historia violenta: la unión de dos astros que, al colisionar, dieron lugar a una enana blanca con características únicas.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">El Hubble revela las secuelas de una extraña colisión entre estrellas</simanw:titulo>
    <simanw:tokensClave xml:lang="es">hubble, revela, secuelas, extraña, colisión, estrellas, estrella, desafía, reglas, conocidas, evolución, estelar, sido, identificada, gracias</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/El-Hubble-revela-las-secuelas-de-una-extrana-colision-entre-estrellas"/>
  </rdf:Description>
