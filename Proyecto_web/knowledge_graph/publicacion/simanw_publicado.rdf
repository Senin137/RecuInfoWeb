  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_372_2cecbb76ca">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un análisis de isótopos de rocas lunares y terrestres, publicado en Science, revela que el hipotético planeta que chocó contra la Tierra y dio lugar a nuestro satélite hace 4 500 millones de años viene de más cerca del Sol de lo esperado.</dc:description>
    <dc:title xml:lang="es">El planeta Theia que formó la Luna viene del interior del sistema solar</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-planeta-Theia-que-formo-la-Luna-viene-del-interior-del-sistema-solar</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_mar%C3%ADa_g_dionis"/>
    <simanw:fechaPublicacion>Thu, 20 Nov 2025 20:00:19 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_luna"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_science"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_theia"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un análisis de isótopos de rocas lunares y terrestres, publicado en Science, revela que el hipotético planeta que chocó contra la Tierra y dio lugar a nuestro satélite hace 4 500 millones de años viene de más cerca del Sol de lo esperado.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
