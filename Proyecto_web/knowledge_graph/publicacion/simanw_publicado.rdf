  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_749_61ada9be9e">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La deuda pública de México se mantiene bajo control y alineada con la capacidad de pago del país, aseguró la Secretaría de Hacienda y Crédito Público (SHCP), y destacó que su sostenibilidad debe analizarse en relación con el tamaño de la economía, su composición, el costo financiero, plazo promedio y perfil de vencimientos.</dc:description>
    <dc:title xml:lang="es">La deuda pública se mantiene en una trayectoria sostenible: SHCP</dc:title>
    <dcterms:identifier>https://www.jornada.com.mx/2026/06/02/economia/018n1eco?partner=rss</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">economia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>Tue, 02 Jun 2026 08:32:37 GMT</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.jornada.com.mx/rss/economia.xml?v=1</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_cr%C3%A9dito_p%C3%BAblico"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_hacienda"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_m%C3%A9xico"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_secretar%C3%ADa"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_jornada_com_mx_rss_economia_xml_v_1"/>
    <simanw:resumen xml:lang="es">La deuda pública de México se mantiene bajo control y alineada con la capacidad de pago del país, aseguró la Secretaría de Hacienda y Crédito Público (SHCP), y destacó que su sostenibilidad debe analizarse en relación con el tamaño de la economía, su composición, el costo financiero, plazo promedio y perfil de vencimientos.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_economia"/>
