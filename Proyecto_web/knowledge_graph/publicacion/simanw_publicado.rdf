    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">El proyecto utilizará el supercomputador MareNostrum 5 para probar protocolos de cómputo urgente y responder de forma inmediata a emergencias como terremotos, tsunamis o erupciones volcánicas. En el experimento de este 19 de septiembre, el sistema generará mapas de simulación sísmica que abarcarán la mitad del territorio mexicano.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
