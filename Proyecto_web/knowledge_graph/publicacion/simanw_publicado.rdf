  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_435_282a68f74a">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Los astrónomos han podido confirmar una brillante actividad auroral en Neptuno, gracias a las imágenes captadas por el telescopio espacial James Webb. El hallazgo ayudará a comprender la naturaleza del campo magnético del último planeta del sistema solar.</dc:description>
    <dc:title xml:lang="es">El Webb fotografía por primera vez las auroras de Neptuno</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-Webb-fotografia-por-primera-vez-las-auroras-de-Neptuno</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Fri, 28 Mar 2025 08:00:08 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_el_webb"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_james_webb"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_neptuno"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_neptuno_los"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Los astrónomos han podido confirmar una brillante actividad auroral en Neptuno, gracias a las imágenes captadas por el telescopio espacial James Webb. El hallazgo ayudará a comprender la naturaleza del campo magnético del último planeta del sistema solar.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">El Webb fotografía por primera vez las auroras de Neptuno</simanw:titulo>
