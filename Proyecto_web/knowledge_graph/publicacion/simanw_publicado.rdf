  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_43_55dae996d9">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Microsoft ha lanzado su primer modelo de inteligencia artificial orientado al desarrollo de software. Conocido como MAI-Code-1-Flash, la nueva IA compite contra los modelos ligeros de Anthropic, Google y otras empresas. El modelo se integra a GitHub Copilot a partir de hoy y también está disponible para usuarios individuales a través de Visual Stud</dc:description>
    <dc:title xml:lang="es">Olvídate de Claude Code: Microsoft ha presentado su primera IA para programar software</dc:title>
    <dcterms:identifier>https://hipertextual.com/inteligencia-artificial/microsoft-mai-code-1-flash-github-copilot/</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_luis_miranda"/>
