  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_549_7febeb604b">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Las autoridades islandesas rebajaron el nivel de alerta por la erupción del volcán Bardarbunga, en Islandia, debido a la falta de cenizas. En su momento álgido, los chorros de lava alcanzaron los 50 metros de altura.</dc:description>
    <dc:title xml:lang="es">Vea la erupción de un volcán con chorros de lava de 50 metros en Islandia</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/video_fotos/2014/09/140901_video_volcan_islandia_erupcion_lava_pea.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-02T12:22:17+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/ciencia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_bardarbunga"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_islandia"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_islandia_las"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_ciencia_index_xml"/>
    <simanw:resumen xml:lang="es">Las autoridades islandesas rebajaron el nivel de alerta por la erupción del volcán Bardarbunga, en Islandia, debido a la falta de cenizas. En su momento álgido, los chorros de lava alcanzaron los 50 metros de altura.</simanw:resumen>
