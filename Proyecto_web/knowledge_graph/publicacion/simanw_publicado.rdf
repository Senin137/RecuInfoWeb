  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_907_a30089fe1d">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Al instalar la Comisión Temporal de Presupuesto 2027 del Instituto Nacional Electoral (INE), la consejera Rita Bell López manifestó su preocupación por la serie de renuncias que se han solicitado a funcionarios de carrera, quienes llevaban años en el órgano electoral y ahora están a la espera del pago pendiente de sus prestaciones.</dc:description>
    <dc:title xml:lang="es">Instalan Comisión Temporal de Presupuesto en el INE</dc:title>
    <dcterms:identifier>https://www.jornada.com.mx/2026/06/02/politica/012n2pol?partner=rss</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">gobierno</simanw:categoriaTexto>
