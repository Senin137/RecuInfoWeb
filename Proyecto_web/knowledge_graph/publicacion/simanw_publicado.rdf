  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_399_1d5f032a74">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">A partir del 11 de agosto llegará el gran momento de Las Perseidas, el sueño popular de las estrellas fugaces. Nada mejor que una noche templada de verano, lejos de las luces de la ciudad, al amparo de la mayor oscuridad posible, para esperarlas.</dc:description>
    <dc:title xml:lang="es">Esperando a las Perseidas: qué ver en el cielo de una noche de verano</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Opinion/Esperando-a-las-Perseidas-que-ver-en-el-cielo-de-una-noche-de-verano</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_v%C3%ADctor_lanchares_barrasa"/>
    <simanw:fechaPublicacion>Mon, 11 Aug 2025 10:18:21 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_esperando"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_las_perseidas"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_nada"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_perseidas"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">A partir del 11 de agosto llegará el gran momento de Las Perseidas, el sueño popular de las estrellas fugaces. Nada mejor que una noche templada de verano, lejos de las luces de la ciudad, al amparo de la mayor oscuridad posible, para esperarlas.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.4215</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
