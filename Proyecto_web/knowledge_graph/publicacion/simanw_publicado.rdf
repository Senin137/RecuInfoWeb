  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_352_aa82604c3a">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Imágenes del telescopio James Webb han permitido reconstruir con un detalle sin precedentes el entramado invisible que sostiene la arquitectura del cosmos. El resultado ofrece una visión más precisa del papel de la materia oscura en el origen de las primeras estructuras del universo, desde los cúmulos galácticos hasta los sistemas donde surgen estr</dc:description>
    <dc:title xml:lang="es">Crean un mapa de la materia oscura del universo con una resolución inédita</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Crean-un-mapa-de-la-materia-oscura-del-universo-con-una-resolucion-inedita</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_mar%C3%ADa_g_dionis"/>
    <simanw:fechaPublicacion>Mon, 26 Jan 2026 17:00:25 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_crean"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_im%C3%A1genes"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_james_webb"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Imágenes del telescopio James Webb han permitido reconstruir con un detalle sin precedentes el entramado invisible que sostiene la arquitectura del cosmos. El resultado ofrece una visión más precisa del papel de la materia oscura en el origen de las primeras estructuras del universo, desde los cúmulos galácticos hasta los sistemas donde surgen estr</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.5574</simanw:sentimientoScore>
