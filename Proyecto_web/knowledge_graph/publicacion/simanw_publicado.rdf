  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_403_8d161e6462">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El Very Large Telescope, del Observatorio Europeo Austral, ha revelado por primera vez la presencia de un protoplaneta dentro de los brazos espirales de un disco de gas y polvo. Este descubrimiento podría confirmar que esas estructuras complejas se originan por la influencia de cuerpos planetarios alrededor de estrellas jóvenes.</dc:description>
    <dc:title xml:lang="es">Detectan un planeta en formación que esculpe su disco protoplanetario</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Detectan-un-planeta-en-formacion-que-esculpe-su-disco-protoplanetario</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Mon, 21 Jul 2025 14:00:04 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_detectan"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_el_very_large"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_este"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_observatorio_europeo_austral"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_telescope"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">El Very Large Telescope, del Observatorio Europeo Austral, ha revelado por primera vez la presencia de un protoplaneta dentro de los brazos espirales de un disco de gas y polvo. Este descubrimiento podría confirmar que esas estructuras complejas se originan por la influencia de cuerpos planetarios alrededor de estrellas jóvenes.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
