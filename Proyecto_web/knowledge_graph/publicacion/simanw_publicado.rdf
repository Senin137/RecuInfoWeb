  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_1174_07eb2de580">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El insomnio suele asociarse al estrés, la ansiedad o el ritmo acelerado de vida, pero cada vez más investigaciones apuntan hacia otro protagonista silencioso: el intestino. Lo que ocurre durante la noche no afecta únicamente al cerebro, también impacta directamente sobre la microbiota, la inflamación y el sistema digestivo. Y viceversa.</dc:description>
    <dc:title xml:lang="es">Experta en microbiota: "Dormir mal no empieza en la almohada, sino en el intestino"</dc:title>
    <dcterms:identifier>https://www.mundodeportivo.com/pulso/20260602/1004190430/malena-garcia-arredondo-experta-microbiota-dormir-mal-no-empieza-almohada-intestino-dct.html</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">deportes</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_oscar_belloch"/>
    <simanw:fechaPublicacion>02 Jun 2026 11:27:39 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.mundodeportivo.com/rss/home.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_dormir"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_experta"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_mundodeportivo_com_rss_home_xml"/>
    <simanw:resumen xml:lang="es">El insomnio suele asociarse al estrés, la ansiedad o el ritmo acelerado de vida, pero cada vez más investigaciones apuntan hacia otro protagonista silencioso: el intestino. Lo que ocurre durante la noche no afecta únicamente al cerebro, también impacta directamente sobre la microbiota, la inflamación y el sistema digestivo. Y viceversa.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.5267</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_deportes"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">Experta en microbiota: "Dormir mal no empieza en la almohada, sino en el intestino"</simanw:titulo>
    <simanw:tokensClave xml:lang="es">experta, microbiota, dormir, mal, empieza, almohada, intestino, insomnio, suele, asociarse, estrés, ansiedad, ritmo, acelerado, vida</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.mundodeportivo.com/pulso/20260602/1004190430/malena-garcia-arredondo-experta-microbiota-dormir-mal-no-empieza-almohada-intestino-dct.html"/>
  </rdf:Description>
