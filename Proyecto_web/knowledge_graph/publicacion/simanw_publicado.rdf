    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Nereida-podria-ser-una-de-las-lunas-originales-de-Neptuno-y-no-una-captura-del-cinturon-de-Kuiper"/>
  </rdf:Description>
