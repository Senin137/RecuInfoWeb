    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Tras tres intentos fallidos, esta vez las dos etapas de la nave más potente del mundo han regresado de forma controlada a la Tierra: una a las aguas del golfo de México y otra al Índico. El avance allana el camino de Estados Unidos para regresar a la Luna y llegar a Marte.</dc:description>
    <dc:title xml:lang="es">El cohete Starship de SpaceX completa su primer regreso desde el espacio</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-cohete-Starship-de-SpaceX-completa-su-primer-regreso-desde-el-espacio</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Fri, 07 Jun 2024 12:58:33 +0200</simanw:fechaPublicacion>
