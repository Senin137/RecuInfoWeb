  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_200_3349829a09">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Investigadores de la Universidad de Granada lideran un estudio para el desarrollo de una técnica probada en volcanes de varios países del mundo, que permite también confirmar el final de una erupción en apenas tres horas, mejorando significativamente los protocolos de seguridad ciudadana.</dc:description>
    <dc:title xml:lang="es">Un nuevo método con IA puede predecir erupciones volcánicas con hasta 12 horas de antelación</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Un-nuevo-metodo-con-IA-puede-predecir-erupciones-volcanicas-con-hasta-12-horas-de-antelacion</dcterms:identifier>
