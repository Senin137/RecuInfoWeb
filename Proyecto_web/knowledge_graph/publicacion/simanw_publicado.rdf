    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra_el"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">El hallazgo de moléculas orgánicas presentes en el ADN y ARN terrestres en un objeto espacial permite entender la forma en la que se generan estos compuestos en entornos inhóspitos. Su descubrimiento refuerza la hipótesis de que los asteroides carbonáceos contribuyeron al inventario químico de la Tierra primitiva.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
