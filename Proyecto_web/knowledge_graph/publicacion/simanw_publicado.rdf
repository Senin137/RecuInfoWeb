  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_383_1519adad04">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un análisis de la Agencia Espacial Europea de remolinos de polvo detectados a través de imágenes que los róveres han tomado durante décadas revela cómo se distribuyen los vientos en el planeta rojo. Los hallazgos se utilizarán para la planificación de futuras misiones.</dc:description>
    <dc:title xml:lang="es">El viento en Marte sopla más fuerte de lo que se pensaba</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-viento-en-Marte-sopla-mas-fuerte-de-lo-que-se-pensaba</dcterms:identifier>
