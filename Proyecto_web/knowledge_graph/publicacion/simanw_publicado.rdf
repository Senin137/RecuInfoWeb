  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_313_6252c4e187">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Mientras que la superficie visible de nuestra estrella ronda los 6 000 grados, su atmósfera exterior puede alcanzar temperaturas mucho más altas y superar varios millones de grados. Un estudio revela que unas estrechas explosiones de plasma, conocidas como nanojets, podrían ser las responsables de que esta última capa sea mucho más cálida.</dc:description>
    <dc:title xml:lang="es">Pequeñas eyecciones de energía en forma de chorro explican el origen del calentamiento coronal del Sol</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Pequenas-eyecciones-de-energia-en-forma-de-chorro-explican-el-origen-del-calentamiento-coronal-del-Sol</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 23 Apr 2026 11:50:02 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_peque%C3%B1as"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_sol_mientras"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Mientras que la superficie visible de nuestra estrella ronda los 6 000 grados, su atmósfera exterior puede alcanzar temperaturas mucho más altas y superar varios millones de grados. Un estudio revela que unas estrechas explosiones de plasma, conocidas como nanojets, podrían ser las responsables de que esta última capa sea mucho más cálida.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">Pequeñas eyecciones de energía en forma de chorro explican el origen del calentamiento coronal del Sol</simanw:titulo>
    <simanw:tokensClave xml:lang="es">pequeñas, eyecciones, energía, forma, chorro, explican, origen, calentamiento, coronal, sol, superficie, visible, estrella, ronda, grados</simanw:tokensClave>
