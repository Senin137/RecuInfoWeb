  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_252_b701e441a7">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El lanzador con el que Europa recupera su acceso autónomo al espacio ha despegado y puesto en órbita los satélites sin problemas, pero una anomalía ha imposibilitado desorbitar la etapa superior y destruirla en la atmósfera como estaba previsto.</dc:description>
    <dc:title xml:lang="es">Éxito del vuelo inaugural de Ariane 6 con una incidencia al final</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Exito-del-vuelo-inaugural-de-Ariane-6-con-una-incidencia-al-final</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Wed, 10 Jul 2024 12:42:43 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_%C3%A9xito"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_ariane"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_europa"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">El lanzador con el que Europa recupera su acceso autónomo al espacio ha despegado y puesto en órbita los satélites sin problemas, pero una anomalía ha imposibilitado desorbitar la etapa superior y destruirla en la atmósfera como estaba previsto.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
