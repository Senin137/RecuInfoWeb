    <simanw:tokensClave xml:lang="es">nave, starliner, vuelve, tierra, tripulantes, tras, desacoplarse, estación, espacial, internacional, cápsula, boeing, aterrizó, vacía, fin</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/La-nave-Starliner-vuelve-a-la-Tierra-sin-sus-dos-tripulantes"/>
  </rdf:Description>
