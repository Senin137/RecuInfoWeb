  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_367_1bc60a8e78">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El telescopio James Webb encuentra que un exoplaneta está rodeado por una capa de gases. El hallazgo desafía la creencia establecida de que los planetas relativamente pequeños tan cerca de sus estrellas no pueden tener atmósferas.</dc:description>
    <dc:title xml:lang="es">Encuentran las primeras evidencias de atmósfera en un exoplaneta rocoso</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Encuentran-las-primeras-evidencias-de-atmosfera-en-un-exoplaneta-rocoso</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Fri, 12 Dec 2025 10:06:28 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_encuentran"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_james_webb"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">El telescopio James Webb encuentra que un exoplaneta está rodeado por una capa de gases. El hallazgo desafía la creencia establecida de que los planetas relativamente pequeños tan cerca de sus estrellas no pueden tener atmósferas.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.296</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">Encuentran las primeras evidencias de atmósfera en un exoplaneta rocoso</simanw:titulo>
    <simanw:tokensClave xml:lang="es">encuentran, primeras, evidencias, atmósfera, exoplaneta, rocoso, telescopio, james, webb, encuentra, exoplaneta, rodeado, capa, gases, hallazgo</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Encuentran-las-primeras-evidencias-de-atmosfera-en-un-exoplaneta-rocoso"/>
