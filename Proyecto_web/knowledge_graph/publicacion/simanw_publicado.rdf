    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La desconexión del emblemático programa de Microsoft en China supone la desaparición definitiva de un servicio que fue pionero en la comunicación instantánea en internet.</dc:description>
    <dc:title xml:lang="es">Fin definitivo del servicio de mensajería instantánea Windows Live Messenger</dc:title>
