  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_277_1ac5ba5f41">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Tras su exitoso despegue este lunes, es muy poco probable que el módulo de aterrizaje robótico Peregrine, construido por la empresa estadounidense Astrobotic, llegue a la superficie lunar debido a “una pérdida crítica de combustible”. A bordo transporta instrumentos científicos de la NASA y otras instituciones.</dc:description>
    <dc:title xml:lang="es">La nave Peregrine falla en su camino hacia la Luna</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/La-nave-Peregrine-falla-en-su-camino-hacia-la-Luna</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Tue, 09 Jan 2024 11:31:08 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_astrobotic"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_luna_tras"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_peregrine"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Tras su exitoso despegue este lunes, es muy poco probable que el módulo de aterrizaje robótico Peregrine, construido por la empresa estadounidense Astrobotic, llegue a la superficie lunar debido a “una pérdida crítica de combustible”. A bordo transporta instrumentos científicos de la NASA y otras instituciones.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
