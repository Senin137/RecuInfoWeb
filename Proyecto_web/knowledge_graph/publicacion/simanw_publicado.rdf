  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_836_e313a083dc">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El grupo textil registra unas ventas de 8.750 millones de euros en el primer trimestre, un 5,8% más, e inicia el segundo trimestre del año con un incremento de su facturación del 11,5% a divisa constante.&amp;nbsp;Leer</dc:description>
    <dc:title xml:lang="es">Inditex acelera su ritmo de crecimiento y gana  1.375 millones en el inicio del año</dc:title>
