  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_264_c3d24be6d4">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Investigadores de la compañía Google DeepMind han desarrollado Tactic AI, un asistente que podría ayudar a los entrenadores a elegir las mejores configuraciones de jugadores tras un saque de esquina. La herramienta se ha entrenado con datos de más de 7000 córneres de la Premier League y la han validado expertos del Liverpool FC.</dc:description>
    <dc:title xml:lang="es">Inteligencia artificial para mejorar tácticas en el fútbol</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Inteligencia-artificial-para-mejorar-tacticas-en-el-futbol</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Tue, 19 Mar 2024 17:00:12 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_google_deep"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_inteligencia"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_investigadores"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_premier_league"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tactic"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Investigadores de la compañía Google DeepMind han desarrollado Tactic AI, un asistente que podría ayudar a los entrenadores a elegir las mejores configuraciones de jugadores tras un saque de esquina. La herramienta se ha entrenado con datos de más de 7000 córneres de la Premier League y la han validado expertos del Liverpool FC.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
