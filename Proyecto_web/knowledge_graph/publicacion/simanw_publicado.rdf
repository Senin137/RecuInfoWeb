  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_1134_3b71679f76">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La influencer y empresaria catalana Jessica Goicoechea puso fin a su mediática relación con Manu Moreno durante el verano de 2025 y todo apuntaba a que sus caminos habían tomado direcciones distintas para siempre. Sin embargo, varios meses después, la historia ha dado un giro inesperado.</dc:description>
    <dc:title xml:lang="es">Jessica Goicoechea se da una nueva oportunidad con su ex</dc:title>
    <dcterms:identifier>https://www.mundodeportivo.com/elotromundo/gente/20260602/1004190508/jessica-goicoechea-da-nueva-oportunidad-ex-imagenes-confirman-reconciliacion-manu-moreno-dct.html</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">deportes</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_celia_lucas"/>
    <simanw:fechaPublicacion>02 Jun 2026 14:09:36 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.mundodeportivo.com/rss/home.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_jessica_goicoechea"/>
