  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_183_74440221b7">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Con una resolución sin precedentes, este método, llamado LidarTeam, facilita hacer comparaciones más fiables a lo largo del tiempo para entender mejor la dinámica vertical del territorio. Además, opera con una gran cantidad de metadatos asociados en acceso abierto.</dc:description>
    <dc:title xml:lang="es">Una nueva herramienta permite medir los cambios en la altura de árboles y edificios</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Una-nueva-herramienta-permite-medir-los-cambios-en-la-altura-de-arboles-y-edificios</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 16 Apr 2026 08:10:13 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_adem%C3%A1s"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_lidar"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Con una resolución sin precedentes, este método, llamado LidarTeam, facilita hacer comparaciones más fiables a lo largo del tiempo para entender mejor la dinámica vertical del territorio. Además, opera con una gran cantidad de metadatos asociados en acceso abierto.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.5574</simanw:sentimientoScore>
