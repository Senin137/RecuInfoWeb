  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_543_1310de7fbc">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un animal marino con forma de hongo descubierto frente a las costas de Australia ha dejado perplejo a muchos científicos por la imposibilidad de clasificarlo. El hecho ha ocurrido muy pocas veces en los últimos 100 años.</dc:description>
    <dc:title xml:lang="es">Extraño animal de las profundidades desafía a los biólogos</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/noticias/2014/09/140903_animal_como_hongo_marino_ao.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-04T00:21:02+00:00</simanw:fechaPublicacion>
