    <dcterms:identifier>http://www.bbc.co.uk/mundo/noticias/2014/08/140829_tecnologia_muerte_contrasenas_ig.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
