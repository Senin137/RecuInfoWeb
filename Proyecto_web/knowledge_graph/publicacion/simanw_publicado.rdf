  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_269_efffc5de28">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La Fundación BBVA ha galardonado al informático japonés, de la Universidad Carnegie Mellon (EE UU), por crear los algoritmos que permiten a las máquinas comprender las imágenes y procesar los movimientos. Sus técnicas están presentes en los coches autónomos, los drones y todos los robots con capacidad de visión, como los que se usan en cirugía.</dc:description>
    <dc:title xml:lang="es">Premio Fronteras del Conocimiento a Takeo Kanade, pionero de la visión artificial en 3D</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Premio-Fronteras-del-Conocimiento-a-Takeo-Kanade-pionero-de-la-vision-artificial-en-3D</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 08 Feb 2024 12:17:27 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_conocimiento"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_la_fundaci%C3%B3n"/>
