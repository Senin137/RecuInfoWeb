  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_412_10b78f378f">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Gracias al telescopio VLT, un grupo de investigadores ha logrado crear un mapa en alta resolución que permite explorar, como nunca antes, el interior y la evolución de la Galaxia del Escultor. El estudio abre una nueva ventana al conocimiento de cómo nacen, viven y mueren las estrellas.</dc:description>
    <dc:title xml:lang="es">Captan la imagen más detallada de una galaxia con miles de colores</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Captan-la-imagen-mas-detallada-de-una-galaxia-con-miles-de-colores</dcterms:identifier>
