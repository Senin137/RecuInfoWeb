  </rdf:Description>
  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_208_1d88f79ced">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Los ataques informáticos pueden poner en jaque la supervivencia de muchas empresas. La preparación ante estas amenazas no solo requiere tecnología, sino también una cultura organizativa orientada a la prevención y la recuperación. La iniciativa España Digital 2026 busca reducir la brecha de exposición al riesgo.</dc:description>
    <dc:title xml:lang="es">Claves de ciberseguridad y resiliencia empresarial para afrontar un ciberataque</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Opinion/Claves-de-ciberseguridad-y-resiliencia-empresarial-para-afrontar-un-ciberataque</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_jes%C3%BAs_barrena_mart%C3%ADnez_y_nikol_alejandra_pe%C3%B1a_vanegas"/>
    <simanw:fechaPublicacion>Fri, 11 Jul 2025 08:00:10 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_claves"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_espa%C3%B1a_digital"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Los ataques informáticos pueden poner en jaque la supervivencia de muchas empresas. La preparación ante estas amenazas no solo requiere tecnología, sino también una cultura organizativa orientada a la prevención y la recuperación. La iniciativa España Digital 2026 busca reducir la brecha de exposición al riesgo.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.296</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">Claves de ciberseguridad y resiliencia empresarial para afrontar un ciberataque</simanw:titulo>
    <simanw:tokensClave xml:lang="es">claves, ciberseguridad, resiliencia, empresarial, afrontar, ciberataque, ataques, informáticos, pueden, poner, jaque, supervivencia, muchas, empresas, preparación</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Opinion/Claves-de-ciberseguridad-y-resiliencia-empresarial-para-afrontar-un-ciberataque"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_408_7f0249dd87">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un patrón detectado en los restos de una estrella ha confirmado que esta estalló en dos fases, lo que sugiere que algunas supernovas tipo Ia pueden originarse de esta forma. La observación, realizada con el Very Large Telescope, aporta nuevas pistas sobre estos fenómenos, fundamentales para comprender la evolución y la expansión del universo.</dc:description>
    <dc:title xml:lang="es">Algunas estrellas estallan dos veces antes de morir</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Algunas-estrellas-estallan-dos-veces-antes-de-morir</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Wed, 02 Jul 2025 11:00:03 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_algunas"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_very_large_telescope"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un patrón detectado en los restos de una estrella ha confirmado que esta estalló en dos fases, lo que sugiere que algunas supernovas tipo Ia pueden originarse de esta forma. La observación, realizada con el Very Large Telescope, aporta nuevas pistas sobre estos fenómenos, fundamentales para comprender la evolución y la expansión del universo.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">Algunas estrellas estallan dos veces antes de morir</simanw:titulo>
    <simanw:tokensClave xml:lang="es">estrellas, estallan, veces, morir, patrón, detectado, restos, estrella, confirmado, estalló, fases, sugiere, supernovas, tipo, pueden</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Algunas-estrellas-estallan-dos-veces-antes-de-morir"/>
  </rdf:Description>
