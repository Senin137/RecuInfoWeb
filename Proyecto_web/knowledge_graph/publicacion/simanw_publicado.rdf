  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_330_81b7015d8b">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Tras más de cinco décadas de ausencia humana en el espacio exterior, la misión Artemis II despegará el próximo 1 de abril para sobrevolar por la cara oculta de la Luna. En total, los cuatro astronautas se alejarán más de 400 000 kilómetros de la Tierra, el punto más distante en el cosmos al que jamás haya llegado nuestra especie.</dc:description>
    <dc:title xml:lang="es">Artemis II: el reto espacial más arriesgado y fascinante de nuestra generación</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Opinion/Artemis-II-el-reto-espacial-mas-arriesgado-y-fascinante-de-nuestra-generacion</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_valen_g%C3%B3mez_jos%C3%A9_andr%C3%A9s_d%C3%ADaz_miguel_iglesias_noem%C3%AD_barral"/>
    <simanw:fechaPublicacion>Wed, 25 Mar 2026 10:03:09 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_artemis"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_luna"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tras"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Tras más de cinco décadas de ausencia humana en el espacio exterior, la misión Artemis II despegará el próximo 1 de abril para sobrevolar por la cara oculta de la Luna. En total, los cuatro astronautas se alejarán más de 400 000 kilómetros de la Tierra, el punto más distante en el cosmos al que jamás haya llegado nuestra especie.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">Artemis II: el reto espacial más arriesgado y fascinante de nuestra generación</simanw:titulo>
    <simanw:tokensClave xml:lang="es">artemis, reto, espacial, arriesgado, fascinante, generación, tras, cinco, décadas, ausencia, humana, espacio, exterior, misión, artemis</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Opinion/Artemis-II-el-reto-espacial-mas-arriesgado-y-fascinante-de-nuestra-generacion"/>
  </rdf:Description>
