    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_miden"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un equipo investigador ha calculado la contaminación por litio en la atmósfera alta tras la entrada de un cohete Falcon 9. Estos datos, hasta ahora difíciles de detectar, son esenciales para considerar el impacto en el clima de estos procesos.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
