  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_393_f3e4035212">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El 14 de septiembre de 2015, los detectores LIGO captaron por primera vez una señal inequívoca de ondas gravitacionales. Aquella observación abrió una nueva ventana al cosmos y dio inicio a una disciplina que ha transformado nuestra manera de explorar el cosmos.</dc:description>
    <dc:title xml:lang="es">El gran día de las ondas gravitacionales: una década escuchando señales invisibles del universo</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Opinion/El-gran-dia-de-las-ondas-gravitacionales-una-decada-escuchando-senales-invisibles-del-universo</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_alicia_sintes"/>
    <simanw:fechaPublicacion>Fri, 12 Sep 2025 11:40:23 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_aquella"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">El 14 de septiembre de 2015, los detectores LIGO captaron por primera vez una señal inequívoca de ondas gravitacionales. Aquella observación abrió una nueva ventana al cosmos y dio inicio a una disciplina que ha transformado nuestra manera de explorar el cosmos.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
