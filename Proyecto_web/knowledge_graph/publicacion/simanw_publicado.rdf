  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_266_508fedb869">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">La Agencia Espacial Europea ha confirmado que Heritage ERS-2, después de observar la Tierra y un largo periodo de degradación orbital, se rompió en pedazos este miércoles al entrar en la atmósfera terrestre sobre el Pacífico norte. La previsión es que sus fragmentos se hayan quemado y, de momento, no se han reportado daños.</dc:description>
    <dc:title xml:lang="es">Un viejo satélite de la ESA se desintegra sobre el Pacífico</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Un-viejo-satelite-de-la-ESA-se-desintegra-sobre-el-Pacifico</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Thu, 22 Feb 2024 12:51:12 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_espacial_europea"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_heritage"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_pac%C3%ADfico"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_pac%C3%ADfico_la_agencia"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">La Agencia Espacial Europea ha confirmado que Heritage ERS-2, después de observar la Tierra y un largo periodo de degradación orbital, se rompió en pedazos este miércoles al entrar en la atmósfera terrestre sobre el Pacífico norte. La previsión es que sus fragmentos se hayan quemado y, de momento, no se han reportado daños.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0516</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">Un viejo satélite de la ESA se desintegra sobre el Pacífico</simanw:titulo>
    <simanw:tokensClave xml:lang="es">viejo, satélite, desintegra, pacífico, agencia, espacial, europea, confirmado, heritage, ers, observar, tierra, largo, periodo, degradación</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Un-viejo-satelite-de-la-ESA-se-desintegra-sobre-el-Pacifico"/>
  </rdf:Description>
