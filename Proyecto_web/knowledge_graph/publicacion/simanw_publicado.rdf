  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_1351_61294dea37">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Con el 98,27 % de las mesas contabilizadas, De la Espriella da la sorpresa al pasar de los 10 millones de votos (43,74 %), un resultado mejor que el que le daban las encuestas, en las que siempre estuvo en segundo lugar, detrás de Cepeda.</dc:description>
    <dc:title xml:lang="es">De la Espriella y Cepeda disputarán segunda vuelta presidencial en Colombia; Petro no acepta resultados</dc:title>
