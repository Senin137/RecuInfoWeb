    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_antonio_villarreal"/>
    <simanw:fechaPublicacion>Fri, 20 Mar 2026 13:00:07 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">El informe final de la red europea ENTSO-E descarta que el incidente del 28 de abril de 2025 fuera solo culpa de las renovables y lo atribuye a una “tormenta perfecta” de factores técnicos, desconexiones en cascada y una regulación de red obsoleta.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
