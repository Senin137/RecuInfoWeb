  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_227_cc17fdce43">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">José Antonio Galdón, decano del Colegio Oficial de Graduados, Ingenieros Técnicos Industriales y Peritos Industriales de Madrid, señala a SINC que la caída masiva del suministro eléctrico en España muestra debilidades que deberán solventarse en el futuro para una correcta previsión de la energía en situaciones críticas.</dc:description>
    <dc:title xml:lang="es">El apagón obliga a mejorar la gestión de la energía española, según este ingeniero</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Reportajes/El-apagon-obliga-a-mejorar-la-gestion-de-la-energia-espanola-segun-este-ingeniero</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_marcos_d_oliveros"/>
    <simanw:fechaPublicacion>Wed, 30 Apr 2025 08:30:03 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_colegio_oficial"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_graduados"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_ingenieros_t%C3%A9cnicos_industriales"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_jos%C3%A9_antonio_gald%C3%B3n"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_peritos_industriales"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">José Antonio Galdón, decano del Colegio Oficial de Graduados, Ingenieros Técnicos Industriales y Peritos Industriales de Madrid, señala a SINC que la caída masiva del suministro eléctrico en España muestra debilidades que deberán solventarse en el futuro para una correcta previsión de la energía en situaciones críticas.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
