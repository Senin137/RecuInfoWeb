  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_405_049689225a">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El experimento LHCb del CERN observa por primera vez una violación de simetría materia-antimateria en bariones, un fenómeno que se predijo en los años 60 sobre el origen del universo, pero que nunca antes se había comprobado en las partículas que forman la materia común. Esto podría revelar nuevas vías hacia una física más allá del Modelo Estándar.</dc:description>
    <dc:title xml:lang="es">El CERN confirma que la materia y la antimateria no se comportan igual</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-CERN-confirma-que-la-materia-y-la-antimateria-no-se-comportan-igual</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_antonio_villarreal"/>
    <simanw:fechaPublicacion>Wed, 16 Jul 2025 17:00:21 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_esto"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_modelo_est%C3%A1ndar"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">El experimento LHCb del CERN observa por primera vez una violación de simetría materia-antimateria en bariones, un fenómeno que se predijo en los años 60 sobre el origen del universo, pero que nunca antes se había comprobado en las partículas que forman la materia común. Esto podría revelar nuevas vías hacia una física más allá del Modelo Estándar.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.296</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
    <simanw:titulo xml:lang="es">El CERN confirma que la materia y la antimateria no se comportan igual</simanw:titulo>
    <simanw:tokensClave xml:lang="es">cern, confirma, materia, antimateria, comportan, igual, experimento, lhcb, cern, observa, primera, violación, simetría, materia, antimateria</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/El-CERN-confirma-que-la-materia-y-la-antimateria-no-se-comportan-igual"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_983_ea296fbef8">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Investigaciones aseguran que esta entidad financia asociaciones civiles y organismos públicos para influir en programas. El caso ya está bajo la mira de la OMS.</dc:description>
    <dc:title xml:lang="es">Acusan a Bloomberg Philanthropies de influir en políticas de salud pública en México</dc:title>
    <dcterms:identifier>https://www.lapoliticaonline.com/mexico/politica-mx/acusan-a-bloomberg-philanthropies-de-influir-en-politicas-de-salud-publica-en-mexico-4341/</dcterms:identifier>
