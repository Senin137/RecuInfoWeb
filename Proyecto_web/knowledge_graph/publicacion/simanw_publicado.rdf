    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_m%C3%A9xico"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_jornada_com_mx_rss_economia_xml_v_1"/>
    <simanw:resumen xml:lang="es">Las remesas hacia México sumaron 4 mil 978 millones de dólares en abril, un aumento de 3.7 por ciento respecto al mismo mes del año pasado, y si bien se ha reducido el número total de envíos, cada transferencia es por una mayor cantidad de dinero, reportó el Banco de México (BdeM).</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
