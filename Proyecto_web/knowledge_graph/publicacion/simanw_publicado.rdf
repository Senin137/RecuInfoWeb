  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_1001_1f565939d7">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El PSOE ha reconocido que pagó 44.859 euros a Leire Díez como asesora de comunicación del partido en Cantabria entre 2015 y 2017, frente a los 15.612 euros que ya había admitido ante el juez de Plaza de Castilla que investiga a la exmilitante socialista por presuntos delitos de tráfico de influencias y cohecho.</dc:description>
