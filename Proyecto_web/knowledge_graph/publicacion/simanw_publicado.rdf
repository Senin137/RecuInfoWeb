  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_416_a33f88aa6f">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">No se trata de un acontecimiento astronómico insólito, tan solo un plenilunio más de los que ocurren cada mes. Para César González, divulgador del Planetario de Madrid, su peculiaridad se debe a su nombre, ya que los indígenas americanos la llamaban así por la recolección de fresas en este momento del año.</dc:description>
    <dc:title xml:lang="es">El mito de la ‘luna de fresa’: ni es rosa ni un evento astronómico inusual</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-mito-de-la-luna-de-fresa-ni-es-rosa-ni-un-evento-astronomico-inusual</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Tue, 10 Jun 2025 15:10:19 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_madrid"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_para_c%C3%A9sar_gonz%C3%A1lez"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_planetario"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">No se trata de un acontecimiento astronómico insólito, tan solo un plenilunio más de los que ocurren cada mes. Para César González, divulgador del Planetario de Madrid, su peculiaridad se debe a su nombre, ya que los indígenas americanos la llamaban así por la recolección de fresas en este momento del año.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.296</simanw:sentimientoScore>
