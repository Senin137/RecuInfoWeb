  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_128_04b999f1d0">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Especialistas en seguridad informática afirman que la "verificación en dos pasos", herramienta de protección en la red recomendada por Apple, no es tan efectiva como se cree. La empresa no se ha pronunciado al respecto.</dc:description>
    <dc:title xml:lang="es">Alertan sobre "falla fundamental" en el servicio iCloud de Apple</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/ultimas_noticias/2014/09/140904_tecnologia_apple_filtracion_fotos_seguridad_kv.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-04T11:46:38+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/tecnologia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_alertan"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_apple"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_apple_especialistas"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_tecnologia_index_xml"/>
    <simanw:resumen xml:lang="es">Especialistas en seguridad informática afirman que la "verificación en dos pasos", herramienta de protección en la red recomendada por Apple, no es tan efectiva como se cree. La empresa no se ha pronunciado al respecto.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">negativo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">-0.25</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_negativo"/>
