  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_1254_2c96f84f4a">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Abelardo de la Espriella, un abogado polémico que imita las estrategias de Trump, Bukele o Milei representa una derecha distinta a la que gobernó Colombia por décadas. Él, sin embargo, dice que es más uribista que Álvaro Uribe. Perfil en clave histórica.</dc:description>
    <dc:title xml:lang="es">Cómo se compara la derecha que representa Abelardo de la Espriella con la que siempre gobernó Colombia</dc:title>
    <dcterms:identifier>https://www.bbc.com/mundo/articles/cy42zj9gy4eo?at_medium=RSS&amp;at_campaign=rss</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">deportes</simanw:categoriaTexto>
