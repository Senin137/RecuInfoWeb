  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_441_a03ea96b75">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un nuevo análisis de este experimento internacional que mapea el universo en 3D sugiere que la energía oscura, considerada hasta ahora una constante, podría evolucionar. Si se confirma, este hallazgo desafiaría el modelo estándar y abriría nuevas vías en la comprensión del cosmos.</dc:description>
    <dc:title xml:lang="es">El cartógrafo cósmico DESI detecta indicios de que la energía oscura podría variar con el tiempo</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-cartografo-cosmico-DESI-detecta-indicios-de-que-la-energia-oscura-podria-variar-con-el-tiempo</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 20 Mar 2025 09:59:29 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un nuevo análisis de este experimento internacional que mapea el universo en 3D sugiere que la energía oscura, considerada hasta ahora una constante, podría evolucionar. Si se confirma, este hallazgo desafiaría el modelo estándar y abriría nuevas vías en la comprensión del cosmos.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
