  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_319_b456f1d306">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Cuando el Sol se pone en el horizonte, las farolas empiezan a encenderse para iluminar la vida nocturna, un hecho que puede observarse desde el espacio exterior. Un estudio ha analizado millones de imágenes de la Tierra, en las que se muestra que el planeta ‘parpadea’ debido a cambios en la emisión de estas luces artificiales.</dc:description>
    <dc:title xml:lang="es">El uso de luces nocturnas ha crecido un 16 % en la última década</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-uso-de-luces-nocturnas-ha-crecido-un-16-en-la-ultima-decada</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Wed, 08 Apr 2026 17:00:27 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_cuando"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Cuando el Sol se pone en el horizonte, las farolas empiezan a encenderse para iluminar la vida nocturna, un hecho que puede observarse desde el espacio exterior. Un estudio ha analizado millones de imágenes de la Tierra, en las que se muestra que el planeta ‘parpadea’ debido a cambios en la emisión de estas luces artificiales.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5859</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">El uso de luces nocturnas ha crecido un 16 % en la última década</simanw:titulo>
    <simanw:tokensClave xml:lang="es">uso, luces, nocturnas, crecido, última, década, sol, pone, horizonte, farolas, empiezan, encenderse, iluminar, vida, nocturna</simanw:tokensClave>
