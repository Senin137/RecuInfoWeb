    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_ciencia_index_xml"/>
    <simanw:resumen xml:lang="es">Algunos hablan de la pose de la "estrella de mar", otros de una "actitud de poder": nuestro cuerpo y nuestra mente están conectados bioquímicamente. Sólo controlar el lenguaje corporal puede producir grandes resultados.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
