    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-17T23:21:36+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/ciencia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_astr%C3%B3nomos"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_v%C3%ADa_l%C3%A1ctea"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_ciencia_index_xml"/>
    <simanw:resumen xml:lang="es">El agujero negro posee una masa de de 21 millones de soles -es cinco veces mayor que el del centro de la Vía Láctea- y fue descubierto en una galaxia enana conocida como M60-UCD1.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
