  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_446_09a6db4ea0">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Mañana comienza una sucesión de eventos astronómicos inusuales, con un eclipse total de Luna visible en gran parte del mundo. A este fenómeno le seguirán la alineación de cuatro planetas, el equinoccio de primavera y un eclipse parcial de Sol el día 29. Además, en los próximos años se encadenarán varios eclipses destacados en España.</dc:description>
    <dc:title xml:lang="es">Un eclipse total de Luna da inicio mañana a una serie histórica de eventos astronómicos</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Un-eclipse-total-de-Luna-da-inicio-manana-a-una-serie-historica-de-eventos-astronomicos</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_ra%C3%BAl_casado_efe"/>
    <simanw:fechaPublicacion>Wed, 12 Mar 2025 13:23:16 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_adem%C3%A1s"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_espa%C3%B1a"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_luna"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_ma%C3%B1ana"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Mañana comienza una sucesión de eventos astronómicos inusuales, con un eclipse total de Luna visible en gran parte del mundo. A este fenómeno le seguirán la alineación de cuatro planetas, el equinoccio de primavera y un eclipse parcial de Sol el día 29. Además, en los próximos años se encadenarán varios eclipses destacados en España.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
