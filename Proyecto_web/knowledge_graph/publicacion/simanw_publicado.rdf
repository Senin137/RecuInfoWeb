    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">El planeta Theia que formó la Luna viene del interior del sistema solar</simanw:titulo>
    <simanw:tokensClave xml:lang="es">planeta, theia, formó, luna, viene, interior, sistema, solar, análisis, isótopos, rocas, lunares, terrestres, publicado, science</simanw:tokensClave>
