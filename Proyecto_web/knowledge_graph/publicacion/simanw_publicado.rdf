    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_investigadores"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_universidad"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Investigadores de la Universidad de Granada lideran un estudio para el desarrollo de una técnica probada en volcanes de varios países del mundo, que permite también confirmar el final de una erupción en apenas tres horas, mejorando significativamente los protocolos de seguridad ciudadana.</simanw:resumen>
