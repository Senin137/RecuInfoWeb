  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_302_8ead741901">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Una nueva investigación del Instituto de Astrofísica de Andalucía ha analizado cómo influyen los vacíos cósmicos en la evolución de doscientas galaxias. Estas regiones se caracterizan por tener una densidad de materia muy baja, lo que permite que sean entornos ideales para el estudio de la actividad estelar.</dc:description>
    <dc:title xml:lang="es">Las galaxias retienen mejor el gas y forman estrellas durante más tiempo en vacíos cósmicos</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Las-galaxias-retienen-mejor-el-gas-y-forman-estrellas-durante-mas-tiempo-en-vacios-cosmicos</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 28 May 2026 11:00:04 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_andaluc%C3%ADa"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_astrof%C3%ADsica"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_estas"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_instituto"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Una nueva investigación del Instituto de Astrofísica de Andalucía ha analizado cómo influyen los vacíos cósmicos en la evolución de doscientas galaxias. Estas regiones se caracterizan por tener una densidad de materia muy baja, lo que permite que sean entornos ideales para el estudio de la actividad estelar.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
