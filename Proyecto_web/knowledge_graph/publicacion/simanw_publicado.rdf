  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_419_c49c4ae27b">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un nuevo estudio identifica una nueva fuente emisora radio y rayos X con un patrón intermitente en nuestra galaxia. Estas entidades cósmicas denominadas objetos transitorios de radio de largo periodo fueron descubiertas en 2022 y su presencia desafía por completo las teorías físicas actuales.</dc:description>
    <dc:title xml:lang="es">Detectan un objeto cósmico que emite señales de radio y rayos X en la Vía Láctea</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Detectan-un-objeto-cosmico-que-emite-senales-de-radio-y-rayos-X-en-la-Via-Lactea</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Thu, 29 May 2025 10:10:03 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_detectan"/>
