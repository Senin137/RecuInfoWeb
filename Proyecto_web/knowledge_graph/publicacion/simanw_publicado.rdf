  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_440_8c6f9ddc54">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Dos equipos diferentes de astrónomos han detectado oxígeno en la galaxia JADES-GS-z14-0, a 13 400 millones de años luz de la Tierra, la más distante que se conoce hasta el momento. El hallazgo sugiere que esta es químicamente mucho más madura de lo esperado.</dc:description>
    <dc:title xml:lang="es">Descubren oxígeno en la galaxia más lejana conocida</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Descubren-oxigeno-en-la-galaxia-mas-lejana-conocida</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 20 Mar 2025 14:00:12 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_descubren"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tierra"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Dos equipos diferentes de astrónomos han detectado oxígeno en la galaxia JADES-GS-z14-0, a 13 400 millones de años luz de la Tierra, la más distante que se conoce hasta el momento. El hallazgo sugiere que esta es químicamente mucho más madura de lo esperado.</simanw:resumen>
