  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_109_6732cf8bcc">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Esas pequeñas calcomanías que a menudo trae la fruta podrían ser cosa del pasado. Una alternativa más ecológica y creativa está en camino: los tatuajes con láser. Les contamos en qué consiste.</dc:description>
    <dc:title xml:lang="es">Tatuajes en la fruta para reemplazar etiquetas</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/noticias/2014/09/140912_tecnologia_tatuajes_fruta_ig.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-12T13:22:57+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/tecnologia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_esas"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_tatuajes"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_tecnologia_index_xml"/>
    <simanw:resumen xml:lang="es">Esas pequeñas calcomanías que a menudo trae la fruta podrían ser cosa del pasado. Una alternativa más ecológica y creativa está en camino: los tatuajes con láser. Les contamos en qué consiste.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
