    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_takeo_kanade"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_universidad_carnegie_mellon"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">La Fundación BBVA ha galardonado al informático japonés, de la Universidad Carnegie Mellon (EE UU), por crear los algoritmos que permiten a las máquinas comprender las imágenes y procesar los movimientos. Sus técnicas están presentes en los coches autónomos, los drones y todos los robots con capacidad de visión, como los que se usan en cirugía.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
