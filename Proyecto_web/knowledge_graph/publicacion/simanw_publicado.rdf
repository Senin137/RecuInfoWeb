  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_212_c2090fd963">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un equipo de investigación de Reino Unido ha transformado una bacteria para que produzca este analgésico y antipirético a partir del plástico de botellas desechadas. Este proceso no emite gases de efecto invernadero y su producción resulta más sostenible que la habitual, que utiliza combustibles fósiles.</dc:description>
    <dc:title xml:lang="es">Una bacteria es capaz de convertir botellas de plástico en paracetamol</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Una-bacteria-es-capaz-de-convertir-botellas-de-plastico-en-paracetamol</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_mar%C3%ADa_g_dionis"/>
    <simanw:fechaPublicacion>Mon, 23 Jun 2025 17:00:27 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_este"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_reino_unido"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Un equipo de investigación de Reino Unido ha transformado una bacteria para que produzca este analgésico y antipirético a partir del plástico de botellas desechadas. Este proceso no emite gases de efecto invernadero y su producción resulta más sostenible que la habitual, que utiliza combustibles fósiles.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0516</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_tecnologia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">Una bacteria es capaz de convertir botellas de plástico en paracetamol</simanw:titulo>
    <simanw:tokensClave xml:lang="es">bacteria, capaz, convertir, botellas, plástico, paracetamol, equipo, investigación, reino, unido, transformado, bacteria, produzca, analgésico, antipirético</simanw:tokensClave>
