  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_142_ddac0f19c4">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">A nadie le gusta llenar la memoria con decenas de claves de seguridad que además suelen ser fáciles de hackear. Muchos creen que la era de las contraseñas está por teminar, pero ¿qué alternativas hay?</dc:description>
