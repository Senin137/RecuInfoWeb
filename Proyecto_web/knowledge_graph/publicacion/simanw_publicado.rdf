  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_247_7e8096f53f">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Una cápsula Dragon de SpaceX despegó este martes comandada por el multimillonario Jared Isaacman, que junto a la ingeniera Sarah Gillis trataran de dar un paseo espacial este jueves. La nave ya superó esta noche los 1.400 km de distancia de la Tierra, el viaje tripulado más lejano desde las misiones Apolo hace más de 50 años.</dc:description>
    <dc:title xml:lang="es">La misión Polaris Dawn intentará esta semana la primera caminata espacial privada</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/La-mision-Polaris-Dawn-intentara-esta-semana-la-primera-caminata-espacial-privada</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Wed, 11 Sep 2024 14:26:57 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_dragon"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_jared_isaacman"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_polaris_dawn"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_sarah_gillis"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_space"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:relacionadaConDataset rdf:resource="https://simanw.local/recurso/dataset_emisiones_clima_mx"/>
    <simanw:resumen xml:lang="es">Una cápsula Dragon de SpaceX despegó este martes comandada por el multimillonario Jared Isaacman, que junto a la ingeniera Sarah Gillis trataran de dar un paseo espacial este jueves. La nave ya superó esta noche los 1.400 km de distancia de la Tierra, el viaje tripulado más lejano desde las misiones Apolo hace más de 50 años.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
