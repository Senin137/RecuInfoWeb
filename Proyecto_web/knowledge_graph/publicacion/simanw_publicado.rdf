    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_v%C3%ADa_l%C3%A1ctea_un"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un nuevo estudio identifica una nueva fuente emisora radio y rayos X con un patrón intermitente en nuestra galaxia. Estas entidades cósmicas denominadas objetos transitorios de radio de largo periodo fueron descubiertas en 2022 y su presencia desafía por completo las teorías físicas actuales.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
