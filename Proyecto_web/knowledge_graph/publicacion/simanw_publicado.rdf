  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_494_f6a067ddda">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Algunos hablan de la pose de la "estrella de mar", otros de una "actitud de poder": nuestro cuerpo y nuestra mente están conectados bioquímicamente. Sólo controlar el lenguaje corporal puede producir grandes resultados.</dc:description>
    <dc:title xml:lang="es">Cómo cambiar tu postura puede cambiar tu destino en el trabajo</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/noticias/2014/09/140908_vert_cap_como_hablar_en_publico_yv.shtml</dcterms:identifier>
