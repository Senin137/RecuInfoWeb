    <simanw:resumen xml:lang="es">Esta fina estructura se localiza a doscientos mil kilómetros bajo la superficie del astro, donde se alcanzan temperaturas superiores a dos millones de grados. Un estudio internacional emplea técnicas heliosismológicas para comprender su naturaleza y su función en la creación de tormentas solares.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">Esta es la tacoclina, una capa del Sol esencial para la creación de su campo magnético</simanw:titulo>
    <simanw:tokensClave xml:lang="es">tacoclina, capa, sol, esencial, creación, campo, magnético, fina, estructura, localiza, doscientos, mil, kilómetros, bajo, superficie</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/Esta-es-la-tacoclina-una-capa-del-Sol-esencial-para-la-creacion-de-su-campo-magnetico"/>
  </rdf:Description>
