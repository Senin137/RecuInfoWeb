  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_429_50c2056bea">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un estudio con participación española ha logrado la medición más precisa de la masa de los neutrinos, la partícula más ligera del universo. El valor se ha fijado 0,45 electrovoltios, una millonésima parte de la que tiene un electrón.</dc:description>
    <dc:title xml:lang="es">Miden el límite superior más preciso para la masa de los neutrinos</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Miden-el-limite-superior-mas-preciso-para-la-masa-de-los-neutrinos</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_efe"/>
    <simanw:fechaPublicacion>Fri, 11 Apr 2025 09:00:07 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_miden"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un estudio con participación española ha logrado la medición más precisa de la masa de los neutrinos, la partícula más ligera del universo. El valor se ha fijado 0,45 electrovoltios, una millonésima parte de la que tiene un electrón.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.8074</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
