  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_115_b69534d8b4">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Ahora algunos la apodan el Silicon Valley chino, pero hace apenas 30 años en lugar de fabricar microchips sus habitantes se dedicaban a la pesca. ¿Cómo sufrió esta transformación?</dc:description>
    <dc:title xml:lang="es">Shenzhen, la aldea pesquera china que se volvió capital tecnológica</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/noticias/2014/09/140909_tecnologia_china_perfil_shenzhen_ig.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">tecnologia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-10T14:07:19+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/tecnologia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_ahora"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_c%C3%B3mo"/>
