  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_289_faa1d7b0b3">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Para mejorar estas replicas virtuales de procesos reales, ingenieros de la Universidad de Málaga han desarrollado un marco que integra sus principales componentes: la monitorización a través del internet de las cosas, la inteligencia artificial con su capacidad predictiva, los modelos de simulación y la visualización en 3D.</dc:description>
    <dc:title xml:lang="es">Plataforma de código abierto para la nueva generación de gemelos digitales</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Plataforma-de-codigo-abierto-para-la-nueva-generacion-de-gemelos-digitales</dcterms:identifier>
