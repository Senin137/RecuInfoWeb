    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_astrof%C3%ADsica"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_captan"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_el_instituto"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">El Instituto de Astrofísica de Andalucía (IAA-CSIC) ha obtenido imágenes que revelan la estructura interna de un ‘jet’ expulsado por una estrella joven y su interacción con el entorno. El hallazgo permite confirmar por primera vez un modelo teórico planteado hace tres décadas sobre la dinámica de los jets estelares.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
