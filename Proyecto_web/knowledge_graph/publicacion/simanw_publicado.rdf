  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_500_52b1284982">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Hasta la fecha, la NASA solo ha descubierto el 10% del total estimado y es poco probable que se logre cumplir con la meta de finalizar en 2020, como estaba estipulado.</dc:description>
    <dc:title xml:lang="es">Critican a la NASA por fallas en la identificación de asteroides peligrosos</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/ultimas_noticias/2014/09/140915_ultnot_nasa_criticas_asteroide_en.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-15T23:14:38+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/ciencia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_critican"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_hasta"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_ciencia_index_xml"/>
    <simanw:resumen xml:lang="es">Hasta la fecha, la NASA solo ha descubierto el 10% del total estimado y es poco probable que se logre cumplir con la meta de finalizar en 2020, como estaba estipulado.</simanw:resumen>
