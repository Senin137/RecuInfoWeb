  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_239_429d92d130">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">¿Cómo el clima terrestre puede afectar el espacial? El pasado septiembre, el Experimento de Ondas Atmosféricas de la NASA registró enormes oleadas en la atmósfera, producidas por el huracán Helene. Esta información es clave para entender cómo estos fenómenos pueden interrumpir satélites y otras tecnologías.</dc:description>
    <dc:title xml:lang="es">El huracán Helene generó gigantescas olas de gravedad atmosféricas</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/El-huracan-Helene-genero-gigantescas-olas-de-gravedad-atmosfericas</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 14 Nov 2024 08:50:04 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_c%C3%B3mo"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_esta"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_experimento"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_helene"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_ondas_atmosf%C3%A9ricas"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:relacionadaConDataset rdf:resource="https://simanw.local/recurso/dataset_emisiones_clima_mx"/>
    <simanw:resumen xml:lang="es">¿Cómo el clima terrestre puede afectar el espacial? El pasado septiembre, el Experimento de Ondas Atmosféricas de la NASA registró enormes oleadas en la atmósfera, producidas por el huracán Helene. Esta información es clave para entender cómo estos fenómenos pueden interrumpir satélites y otras tecnologías.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
