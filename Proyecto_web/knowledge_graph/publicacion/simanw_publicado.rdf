    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">¿Podrá aterrizar Hayabusa2? Un equipo de astrónomos y astrónomas ha utilizado observatorios de todo el mundo, incluido el Very Large Telescope del Observatorio Europeo Austral (VLT de ESO), para estudiar el asteroide 1998 KY26, revelando que es casi tres veces más pequeño y gira mucho más rápido de lo que se pensaba.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
