  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_368_6ad39519b2">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">Un nuevo estudio internacional con participación española vuelve a poner bajo el microscopio a una de las partículas más escurridizas del cosmos. Aunque durante años se ha planteado la posibilidad de un cuarto tipo de neutrino capaz de explicar ciertas anomalías, los últimos resultados reducen aún más el margen para su existencia.</dc:description>
    <dc:title xml:lang="es">MicroBooNE descarta la existencia de un neutrino estéril tras analizar datos de dos haces</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/MicroBooNE-descarta-la-existencia-de-un-neutrino-esteril-tras-analizar-datos-de-dos-haces</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_sinc"/>
    <simanw:fechaPublicacion>Thu, 04 Dec 2025 11:53:08 +0100</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Ciencia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_aunque"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_micro"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_ciencia"/>
    <simanw:resumen xml:lang="es">Un nuevo estudio internacional con participación española vuelve a poner bajo el microscopio a una de las partículas más escurridizas del cosmos. Aunque durante años se ha planteado la posibilidad de un cuarto tipo de neutrino capaz de explicar ciertas anomalías, los últimos resultados reducen aún más el margen para su existencia.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">positivo</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.34</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_positivo"/>
    <simanw:titulo xml:lang="es">MicroBooNE descarta la existencia de un neutrino estéril tras analizar datos de dos haces</simanw:titulo>
    <simanw:tokensClave xml:lang="es">microboone, descarta, existencia, neutrino, estéril, tras, analizar, datos, haces, nuevo, estudio, internacional, participación, española, vuelve</simanw:tokensClave>
    <simanw:url rdf:resource="https://www.agenciasinc.es/esl/Noticias/MicroBooNE-descarta-la-existencia-de-un-neutrino-esteril-tras-analizar-datos-de-dos-haces"/>
  </rdf:Description>
