    <dc:description xml:lang="es">Los delfines pueden "ver" a través de la arena y son considerados como los animales más inteligentes después de los humanos. Pero los perros, eternos amigos del hombre, sobresalen con otros talentos. ¿Es posible compararlos?</dc:description>
    <dc:title xml:lang="es">¿Quiénes son más inteligentes, los perros o los delfines?</dc:title>
    <dcterms:identifier>http://www.bbc.co.uk/mundo/noticias/2014/09/140918_ciencia_perros_delfines_mas_inteligentes_np.shtml</dcterms:identifier>
    <simanw:categoriaTexto xml:lang="es">ciencia</simanw:categoriaTexto>
    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_desconocido"/>
    <simanw:fechaPublicacion>2014-09-18T16:00:22+00:00</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.bbc.com/mundo/temas/ciencia/index.xml</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_pero"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_qui%C3%A9nes"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_bbc_com_mundo_temas_ciencia_index_xml"/>
    <simanw:resumen xml:lang="es">Los delfines pueden "ver" a través de la arena y son considerados como los animales más inteligentes después de los humanos. Pero los perros, eternos amigos del hombre, sobresalen con otros talentos. ¿Es posible compararlos?</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
    <simanw:tieneCategoria rdf:resource="https://simanw.local/recurso/categoria_ciencia"/>
    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">¿Quiénes son más inteligentes, los perros o los delfines?</simanw:titulo>
    <simanw:tokensClave xml:lang="es">quiénes, inteligentes, perros, delfines, delfines, pueden, ver, arena, considerados, animales, inteligentes, humanos, perros, eternos, amigos</simanw:tokensClave>
    <simanw:url rdf:resource="http://www.bbc.co.uk/mundo/noticias/2014/09/140918_ciencia_perros_delfines_mas_inteligentes_np.shtml"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_910_bd7364e836">
