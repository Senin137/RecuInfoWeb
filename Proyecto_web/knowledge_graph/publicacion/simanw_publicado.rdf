    <simanw:fuenteTexto xml:lang="es">https://www.agenciasinc.es/feed/Tecnologia</simanw:fuenteTexto>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_m%C3%A1laga"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_plataforma"/>
    <simanw:mencionaEntidad rdf:resource="https://simanw.local/recurso/entidad_universidad"/>
    <simanw:publicadaPor rdf:resource="https://simanw.local/recurso/fuente_https_www_agenciasinc_es_feed_tecnologia"/>
    <simanw:resumen xml:lang="es">Para mejorar estas replicas virtuales de procesos reales, ingenieros de la Universidad de Málaga han desarrollado un marco que integra sus principales componentes: la monitorización a través del internet de las cosas, la inteligencia artificial con su capacidad predictiva, los modelos de simulación y la visualización en 3D.</simanw:resumen>
    <simanw:sentimientoEtiqueta xml:lang="es">neutral</simanw:sentimientoEtiqueta>
    <simanw:sentimientoScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</simanw:sentimientoScore>
