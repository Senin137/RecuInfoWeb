  <rdf:Description rdf:about="https://simanw.local/recurso/noticia_296_8085494383">
    <rdf:type rdf:resource="https://schema.org/NewsArticle"/>
    <rdf:type rdf:resource="https://simanw.local/ontology#Noticia"/>
    <dc:description xml:lang="es">El Gobierno de España destinará 125 millones de euros al desarrollo de dos cargas útiles de satélite, uno geoestacionario y otro en órbita baja, junto a sus respectivas estaciones terrenas, para la llamada distribución cuántica de claves (QKD). Esta tecnología se podría incorporar en la constelación europea de comunicaciones seguras por satélite.</dc:description>
    <dc:title xml:lang="es">Claves cuánticas en la primera misión geoestacionaria española</dc:title>
    <dcterms:identifier>https://www.agenciasinc.es/esl/Noticias/Claves-cuanticas-en-la-primera-mision-geoestacionaria-espanola</dcterms:identifier>
