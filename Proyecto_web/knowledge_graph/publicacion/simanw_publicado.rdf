    <simanw:tieneSentimiento rdf:resource="https://simanw.local/recurso/sentimiento_neutral"/>
    <simanw:titulo xml:lang="es">Astrónomos descubren enorme agujero negro en pequeña galaxia</simanw:titulo>
    <simanw:tokensClave xml:lang="es">astrónomos, descubren, enorme, agujero, negro, pequeña, galaxia, agujero, negro, posee, masa, millones, soles, cinco, veces</simanw:tokensClave>
    <simanw:url rdf:resource="http://www.bbc.co.uk/mundo/ultimas_noticias/2014/09/140917_ultnot_astronomos_agujero_negro_en.shtml"/>
  </rdf:Description>
