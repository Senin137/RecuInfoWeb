    <simanw:escritaPor rdf:resource="https://simanw.local/recurso/autor_redacci%C3%B3n_foodie"/>
    <simanw:fechaPublicacion>02 Jun 2026 21:25:08 +0200</simanw:fechaPublicacion>
    <simanw:fuenteTexto xml:lang="es">https://www.mundodeportivo.com/rss/home.xml</simanw:fuenteTexto>
