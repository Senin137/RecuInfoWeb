    simanw:fechaPublicacion "Wed, 12 Mar 2025 13:23:16 +0100" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_adem%C3%A1s,
        data:entidad_espa%C3%B1a,
        data:entidad_luna,
        data:entidad_ma%C3%B1ana ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Mañana comienza una sucesión de eventos astronómicos inusuales, con un eclipse total de Luna visible en gran parte del mundo. A este fenómeno le seguirán la alineación de cuatro planetas, el equinoccio de primavera y un eclipse parcial de Sol el día 29. Además, en los próximos años se encadenarán varios eclipses destacados en España."@es ;
