    simanw:mencionaEntidad data:entidad_ahora,
        data:entidad_hallan,
        data:entidad_neptuno,
        data:entidad_tierra ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "La mayoría de los planetas en nuestra galaxia tienen un tamaño entre la Tierra y Neptuno, pero se sabía poco sobre cómo llegan a tener este tamaño. Ahora, en estudio internacional ha revelado las transformaciones radicales que sufren los planetas en formación durante este proceso."@es ;
    simanw:sentimientoEtiqueta "positivo"@es ;
    simanw:sentimientoScore "0.34"^^xsd:float ;
