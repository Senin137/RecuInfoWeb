    simanw:escritaPor data:autor_sinc ;
    simanw:fechaPublicacion "Wed, 17 Dec 2025 09:59:12 +0100" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_andaluc%C3%ADa,
        data:entidad_astrof%C3%ADsica,
        data:entidad_captan,
        data:entidad_el_instituto ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "El Instituto de Astrofísica de Andalucía (IAA-CSIC) ha obtenido imágenes que revelan la estructura interna de un ‘jet’ expulsado por una estrella joven y su interacción con el entorno. El hallazgo permite confirmar por primera vez un modelo teórico planteado hace tres décadas sobre la dinámica de los jets estelares."@es ;
    simanw:sentimientoEtiqueta "positivo"@es ;
    simanw:sentimientoScore "0.34"^^xsd:float ;
    simanw:tieneCategoria data:categoria_ciencia ;
    simanw:tieneSentimiento data:sentimiento_positivo ;
