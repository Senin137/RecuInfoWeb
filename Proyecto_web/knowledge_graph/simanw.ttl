data:noticia_835_356c67c145 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "La Organización alerta de que si el conflicto no se resuelve a corto plazo, el PIB mundial vería mermado su crecimiento hasta el 2,1% en 2026, frente al 3,4% de 2025, y al 1,8% en 2027, con más inflación y paro, menos inversión e incluso recesión en \"algunas economías\".&nbsp;Leer"@es ;
    dc:title "OCDE: el crecimiento mundial se reducirá drásticamente si la guerra se alarga hasta 2027"@es ;
    dcterms:identifier "https://www.expansion.com/economia/2026/06/03/6a1efd4f468aeb00268b456f.html" ;
    simanw:categoriaTexto "economia"@es ;
    simanw:escritaPor data:autor_j_d%C3%ADaz ;
    simanw:fechaPublicacion "Wed, 03 Jun 2026 09:00:00 +0200" ;
    simanw:fuenteTexto "https://www.expansion.com/rss/portada.xml"@es ;
    simanw:mencionaEntidad data:entidad_la_organizaci%C3%B3n,
        data:entidad_leer ;
