    simanw:escritaPor data:autor_sinc ;
    simanw:fechaPublicacion "Fri, 14 Mar 2025 11:30:51 +0100" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_am%C3%A9rica,
        data:entidad_espa%C3%B1a_en,
        data:entidad_europa,
        data:entidad_la_luna,
        data:entidad_luna ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "En la madrugada del 14 de marzo de 2025, la Luna se oscureció progresivamente hasta quedar completamente teñida de rojo durante un eclipse total. El fenómeno, que no volverá a repetirse hasta 2048, fue visible en América, parte de Europa y, parcialmente, en España."@es ;
