data:noticia_389_d26040e520 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "Un estudio químico de rocas de ambas caras del satélite muestra que la lava de la que proceden se solidificó a diferentes temperaturas. Los investigadores creen que podría deberse a la menor concentración de elementos radiactivos en la cara oculta, que generan calor al desintegrarse."@es ;
    dc:title "La cara oculta de la Luna es 100 ºC más fría que la visible"@es ;
    dcterms:identifier "https://www.agenciasinc.es/esl/Noticias/La-cara-oculta-de-la-Luna-es-100-1C-mas-fria-que-la-visible" ;
