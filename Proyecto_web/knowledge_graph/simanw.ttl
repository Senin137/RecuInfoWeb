        data:entidad_ori%C3%B3n,
        data:entidad_pac%C3%ADfico,
        data:entidad_san_diego,
        data:entidad_tierra ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
