    simanw:escritaPor data:autor_sinc ;
    simanw:fechaPublicacion "Thu, 04 Dec 2025 11:53:08 +0100" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_aunque,
        data:entidad_micro ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Un nuevo estudio internacional con participación española vuelve a poner bajo el microscopio a una de las partículas más escurridizas del cosmos. Aunque durante años se ha planteado la posibilidad de un cuarto tipo de neutrino capaz de explicar ciertas anomalías, los últimos resultados reducen aún más el margen para su existencia."@es ;
    simanw:sentimientoEtiqueta "positivo"@es ;
    simanw:sentimientoScore "0.34"^^xsd:float ;
    simanw:tieneCategoria data:categoria_ciencia ;
    simanw:tieneSentimiento data:sentimiento_positivo ;
    simanw:titulo "MicroBooNE descarta la existencia de un neutrino estéril tras analizar datos de dos haces"@es ;
    simanw:tokensClave "microboone, descarta, existencia, neutrino, estéril, tras, analizar, datos, haces, nuevo, estudio, internacional, participación, española, vuelve"@es ;
    simanw:url <https://www.agenciasinc.es/esl/Noticias/MicroBooNE-descarta-la-existencia-de-un-neutrino-esteril-tras-analizar-datos-de-dos-haces> .

data:noticia_369_d7a9dc81b4 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "El aumento masivo de satélites en órbita plantea un desafío crítico para la observación astronómica. Un estudio en Nature advierte que su impacto podría comprometer la calidad de las imágenes captadas por los principales telescopios espaciales."@es ;
    dc:title "La contaminación lumínica de las megaconstelaciones satelitales afectará a los telescopios"@es ;
    dcterms:identifier "https://www.agenciasinc.es/esl/Noticias/La-contaminacion-luminica-de-las-megaconstelaciones-satelitales-afectara-a-los-telescopios" ;
    simanw:categoriaTexto "ciencia"@es ;
    simanw:escritaPor data:autor_efe ;
    simanw:fechaPublicacion "Thu, 04 Dec 2025 10:52:50 +0100" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_nature ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "El aumento masivo de satélites en órbita plantea un desafío crítico para la observación astronómica. Un estudio en Nature advierte que su impacto podría comprometer la calidad de las imágenes captadas por los principales telescopios espaciales."@es ;
