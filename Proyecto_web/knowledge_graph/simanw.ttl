data:noticia_212_c2090fd963 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "Un equipo de investigación de Reino Unido ha transformado una bacteria para que produzca este analgésico y antipirético a partir del plástico de botellas desechadas. Este proceso no emite gases de efecto invernadero y su producción resulta más sostenible que la habitual, que utiliza combustibles fósiles."@es ;
    dc:title "Una bacteria es capaz de convertir botellas de plástico en paracetamol"@es ;
    dcterms:identifier "https://www.agenciasinc.es/esl/Noticias/Una-bacteria-es-capaz-de-convertir-botellas-de-plastico-en-paracetamol" ;
