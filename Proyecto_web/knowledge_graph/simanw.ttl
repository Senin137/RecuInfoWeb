    simanw:mencionaEntidad data:entidad_crew,
        data:entidad_estaci%C3%B3n_espacial_internacional,
        data:entidad_inicialmente,
        data:entidad_tierra ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "La agencia estadounidense ha anunciado que la tripulación del Crew-11 volverá antes de tiempo a la Tierra antes de la primera caminata espacial del año que estaba programada debido a la mala salud de uno de los miembros. Inicialmente, se planeaba que el equipo se quedaría en la Estación Espacial Internacional hasta marzo de 2026."@es ;
    simanw:sentimientoEtiqueta "positivo"@es ;
    simanw:sentimientoScore "0.34"^^xsd:float ;
    simanw:tieneCategoria data:categoria_ciencia ;
