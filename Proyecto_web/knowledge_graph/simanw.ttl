    simanw:url <https://www.agenciasinc.es/esl/Noticias/Crean-un-posible-habitat-marciano-a-partir-de-bioplasticos-fabricados-por-algas> .

data:noticia_408_7f0249dd87 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "Un patrón detectado en los restos de una estrella ha confirmado que esta estalló en dos fases, lo que sugiere que algunas supernovas tipo Ia pueden originarse de esta forma. La observación, realizada con el Very Large Telescope, aporta nuevas pistas sobre estos fenómenos, fundamentales para comprender la evolución y la expansión del universo."@es ;
    dc:title "Algunas estrellas estallan dos veces antes de morir"@es ;
    dcterms:identifier "https://www.agenciasinc.es/esl/Noticias/Algunas-estrellas-estallan-dos-veces-antes-de-morir" ;
