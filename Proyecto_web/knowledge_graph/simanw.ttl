data:noticia_1185_bb20d21bc0 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "Javier Tebas, presidente de LaLiga, afirmó este martes que si el campeonato del fútbol mexicano quiere crecer debe centralizar los derechos audiovisuales para reforzar su identidad de marca como lo hace el campeonato español.&nbsp;\"Para mí, lo más importante es la centralización de los derechos audiovisuales. Con nosotros LaLiga es la que tiene y v"@es ;
    dc:title "\"El City es el City porque juega en una gran marca como es la Premier League\""@es ;
    dcterms:identifier "https://www.mundodeportivo.com/futbol/laliga/20260603/1004190730/city-city-juega-gran-marca-premier-league.html" ;
    simanw:categoriaTexto "deportes"@es ;
    simanw:escritaPor data:autor_efe_efe ;
    simanw:fechaPublicacion "03 Jun 2026 07:04:48 +0200" ;
    simanw:fuenteTexto "https://www.mundodeportivo.com/rss/home.xml"@es ;
    simanw:mencionaEntidad data:entidad_city,
        data:entidad_el_city,
