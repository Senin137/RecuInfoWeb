data:noticia_1000_f8976d9922 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "Los delitos e incidentes de odio se han incrementado un 23,6% en 2025, registrando la mayor cifra de la serie histórica según el informe anual del Ministerio del Interior, que destaca también el aumento de la participación de los menores en este tipo de delitos, tanto en calidad de víctimas (+17%) como autores (+19%)."@es ;
    dc:title "Los delitos de odio marcan máximo histórico al subir un 23,6% en 2025 y aumenta la participación de menores"@es ;
    dcterms:identifier "https://www.europapress.es/nacional/noticia-delitos-odio-marcan-maximo-historico-subir-236-2025-aumenta-participacion-menores-20260603102615.html" ;
    simanw:categoriaTexto "gobierno"@es ;
    simanw:escritaPor data:autor_desconocido ;
    simanw:fechaPublicacion "Wed, 03 Jun 2026 08:26:15 GMT" ;
    simanw:fuenteTexto "https://www.europapress.es/rss/rss.aspx?ch=00066"@es ;
    simanw:mencionaEntidad data:entidad_interior,
        data:entidad_ministerio ;
    simanw:publicadaPor data:fuente_https_www_europapress_es_rss_rss_aspx_ch_00066 ;
    simanw:resumen "Los delitos e incidentes de odio se han incrementado un 23,6% en 2025, registrando la mayor cifra de la serie histórica según el informe anual del Ministerio del Interior, que destaca también el aumento de la participación de los menores en este tipo de delitos, tanto en calidad de víctimas (+17%) como autores (+19%)."@es ;
    simanw:sentimientoEtiqueta "neutral"@es ;
    simanw:sentimientoScore "0.0"^^xsd:float ;
    simanw:tieneCategoria data:categoria_gobierno ;
    simanw:tieneSentimiento data:sentimiento_neutral ;
    simanw:titulo "Los delitos de odio marcan máximo histórico al subir un 23,6% en 2025 y aumenta la participación de menores"@es ;
    simanw:tokensClave "delitos, odio, marcan, máximo, histórico, subir, aumenta, participación, menores, delitos, incidentes, odio, incrementado, registrando, mayor"@es ;
    simanw:url <https://www.europapress.es/nacional/noticia-delitos-odio-marcan-maximo-historico-subir-236-2025-aumenta-participacion-menores-20260603102615.html> .

data:noticia_1001_1f565939d7 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "El PSOE ha reconocido que pagó 44.859 euros a Leire Díez como asesora de comunicación del partido en Cantabria entre 2015 y 2017, frente a los 15.612 euros que ya había admitido ante el juez de Plaza de Castilla que investiga a la exmilitante socialista por presuntos delitos de tráfico de influencias y cohecho."@es ;
    dc:title "El PSOE eleva a casi 45.000 euros los pagos a Leire Díez como asesora de comunicación en Cantabria en 2015 y 2017"@es ;
