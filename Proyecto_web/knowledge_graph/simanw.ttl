        data:entidad_nanociencia ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_tecnologia ;
    simanw:resumen "El grafeno está formado por átomos de carbono reacios a magnetizarse, pero mediante una nueva técnica de nanoestructuración inteligente este material se puede magnetizar y medir este comportamiento a escala nanométrica. El avance lo presentan investigadores del Instituto de Nanociencia y Materiales de Aragón, el Donostia International Physics Cente"@es ;
    simanw:sentimientoEtiqueta "neutral"@es ;
    simanw:sentimientoScore "0.0"^^xsd:float ;
    simanw:tieneCategoria data:categoria_tecnologia ;
    simanw:tieneSentimiento data:sentimiento_neutral ;
    simanw:titulo "Cómo medir el magnetismo de una nanoestructura de grafeno"@es ;
    simanw:tokensClave "medir, magnetismo, nanoestructura, grafeno, grafeno, formado, átomos, carbono, reacios, magnetizarse, mediante, nueva, técnica, nanoestructuración, inteligente"@es ;
    simanw:url <https://www.agenciasinc.es/esl/Noticias/Como-medir-el-magnetismo-de-una-nanoestructura-de-grafeno> .

data:noticia_293_f24ecd4bb3 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "España se ha convertido en uno de los pocos países capaces de diseñar, fabricar y enviar cohetes al espacio con el lanzamiento este fin de semana desde Huelva de Miura 1, un demostrador tecnológico de la empresa PLD Space. Se han cumplido la mayoría de los objetivos, pero no se ha completado la recuperación de la nave en el océano Atlántico."@es ;
