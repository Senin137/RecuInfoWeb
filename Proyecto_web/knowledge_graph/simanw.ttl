    simanw:publicadaPor data:fuente_https_www_xataka_com_index_xml ;
    simanw:relacionadaConDataset data:dataset_emisiones_clima_mx ;
    simanw:resumen "Corría el año 2018 cuando un equipo de científicos australianos detectó una extraña señal de radio en el plano de la Vía Láctea. El pulso de radio era demasiado lento para cualquier objeto astronómico conocido. Parecía más bien algún tipo de anomalía o error de los telescopios que un nuevo descubrimiento. Sin embargo, en 2025 se localizó otra señal"@es ;
    simanw:sentimientoEtiqueta "negativo"@es ;
    simanw:sentimientoScore "-0.0516"^^xsd:float ;
