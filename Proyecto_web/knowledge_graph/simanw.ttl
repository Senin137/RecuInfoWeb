data:noticia_254_bdafac14ba a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "La velocidad se incrementa a medida que el futbolista se acerca al balón, sin embargo, disminuye ligeramente al llegar a él. Los delanteros son los que corren más directamente hacia el esférico, mientras que los porteros lo hacen de una forma más paralela. Son algunos resultados de un estudio de investigadores españoles."@es ;
    dc:title "Así cambia la velocidad y ángulos en los jugadores de fútbol"@es ;
    dcterms:identifier "https://www.agenciasinc.es/esl/Noticias/Asi-cambia-la-velocidad-y-angulos-en-los-jugadores-de-futbol" ;
    simanw:categoriaTexto "tecnologia"@es ;
    simanw:escritaPor data:autor_sinc ;
    simanw:fechaPublicacion "Tue, 11 Jun 2024 13:30:03 +0200" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Tecnologia"@es ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_tecnologia ;
    simanw:resumen "La velocidad se incrementa a medida que el futbolista se acerca al balón, sin embargo, disminuye ligeramente al llegar a él. Los delanteros son los que corren más directamente hacia el esférico, mientras que los porteros lo hacen de una forma más paralela. Son algunos resultados de un estudio de investigadores españoles."@es ;
    simanw:sentimientoEtiqueta "negativo"@es ;
    simanw:sentimientoScore "-0.5574"^^xsd:float ;
    simanw:tieneCategoria data:categoria_tecnologia ;
    simanw:tieneSentimiento data:sentimiento_negativo ;
    simanw:titulo "Así cambia la velocidad y ángulos en los jugadores de fútbol"@es ;
    simanw:tokensClave "cambia, velocidad, ángulos, jugadores, fútbol, velocidad, incrementa, medida, futbolista, acerca, balón, embargo, disminuye, ligeramente, llegar"@es ;
    simanw:url <https://www.agenciasinc.es/esl/Noticias/Asi-cambia-la-velocidad-y-angulos-en-los-jugadores-de-futbol> .

