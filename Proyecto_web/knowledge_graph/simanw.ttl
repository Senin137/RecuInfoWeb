    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Un nuevo análisis de este experimento internacional que mapea el universo en 3D sugiere que la energía oscura, considerada hasta ahora una constante, podría evolucionar. Si se confirma, este hallazgo desafiaría el modelo estándar y abriría nuevas vías en la comprensión del cosmos."@es ;
    simanw:sentimientoEtiqueta "neutral"@es ;
    simanw:sentimientoScore "0.0"^^xsd:float ;
