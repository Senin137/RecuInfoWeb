    simanw:escritaPor data:autor_antonio_villarreal ;
    simanw:fechaPublicacion "Wed, 16 Jul 2025 17:00:21 +0200" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_esto,
        data:entidad_modelo_est%C3%A1ndar ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "El experimento LHCb del CERN observa por primera vez una violación de simetría materia-antimateria en bariones, un fenómeno que se predijo en los años 60 sobre el origen del universo, pero que nunca antes se había comprobado en las partículas que forman la materia común. Esto podría revelar nuevas vías hacia una física más allá del Modelo Estándar."@es ;
    simanw:sentimientoEtiqueta "negativo"@es ;
    simanw:sentimientoScore "-0.296"^^xsd:float ;
    simanw:tieneCategoria data:categoria_ciencia ;
    simanw:tieneSentimiento data:sentimiento_negativo ;
