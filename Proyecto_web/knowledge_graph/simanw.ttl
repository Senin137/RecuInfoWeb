    simanw:mencionaEntidad data:entidad_calabi ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Una investigación internacional descubre que estructuras matemáticas propias de la teoría de cuerdas, como las variedades de Calabi–Yau, son clave para entender la energía radiada durante estos eventos extremos del universo. Las previsiones logradas no tienen precedentes."@es ;
    simanw:sentimientoEtiqueta "negativo"@es ;
