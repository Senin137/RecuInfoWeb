data:noticia_407_07034a8513 a schema:NewsArticle,
        simanw:Noticia ;
    dc:description "Un equipo investigador en EE UU ha demostrado el crecimiento de algas en bajas presiones similares a las de Marte a través de un refugio de bioplástico producido por estas mismas plantas acuáticas. Este tipo de sistema autosostenible evitaría el transporte de materiales costosos a otros planetas para crear hábitats."@es ;
    dc:title "Crean un posible hábitat marciano a partir de bioplásticos fabricados por algas"@es ;
    dcterms:identifier "https://www.agenciasinc.es/esl/Noticias/Crean-un-posible-habitat-marciano-a-partir-de-bioplasticos-fabricados-por-algas" ;
    simanw:categoriaTexto "ciencia"@es ;
    simanw:escritaPor data:autor_mar%C3%ADa_g_dionis ;
    simanw:fechaPublicacion "Thu, 03 Jul 2025 08:00:25 +0200" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_crean,
        data:entidad_este,
        data:entidad_marte ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Un equipo investigador en EE UU ha demostrado el crecimiento de algas en bajas presiones similares a las de Marte a través de un refugio de bioplástico producido por estas mismas plantas acuáticas. Este tipo de sistema autosostenible evitaría el transporte de materiales costosos a otros planetas para crear hábitats."@es ;
    simanw:sentimientoEtiqueta "positivo"@es ;
    simanw:sentimientoScore "0.34"^^xsd:float ;
