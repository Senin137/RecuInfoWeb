    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_este,
        data:entidad_tierra ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Este objeto cósmico se sitúa a 10 000 millones de años luz de distancia de la Tierra y ha perdido un 5 % de su brillo en dos décadas. Un estudio en el que han participado investigadores españoles sugiere que la estructura gaseosa que lo alimenta se está debilitando y que, por ello, la velocidad a la que fluye la materia hacia su interior ha disminu"@es ;
    simanw:sentimientoEtiqueta "positivo"@es ;
