    simanw:escritaPor data:autor_sinc ;
    simanw:fechaPublicacion "Thu, 21 May 2026 08:00:09 +0200" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_kuiper,
        data:entidad_kuiper_un,
        data:entidad_neptuno,
        data:entidad_nereida,
        data:entidad_seg%C3%BAn ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Un nuevo análisis refuta que Nereida, una de las 16 lunas de Neptuno, fuese tomada desde fuera de la órbita del planeta como el resto de satélites. Según los resultados, su composición es diferente a la de otros objetos del cinturón de Kuiper, lo que la convertiría en el único resto del sistema original de lunas."@es ;
