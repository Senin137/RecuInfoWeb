    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_artemis,
        data:entidad_comienza,
        data:entidad_luna ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Comienza la cuenta atrás de este ambicioso programa espacial que prevé viajar a la Luna y volver en poco menos de diez días. Las condiciones meteorológicas para el despegue son favorables, aunque la institución estadounidense advierte de vientos fuertes y nubosidad."@es ;
