    simanw:fechaPublicacion "Fri, 14 Nov 2025 13:02:50 +0100" ;
    simanw:fuenteTexto "https://www.agenciasinc.es/feed/Ciencia"@es ;
    simanw:mencionaEntidad data:entidad_astrobiolog%C3%ADa,
        data:entidad_basado,
        data:entidad_centro,
        data:entidad_fragmentos,
        data:entidad_marte ;
    simanw:publicadaPor data:fuente_https_www_agenciasinc_es_feed_ciencia ;
    simanw:resumen "Una investigación liderada por el Centro de Astrobiología revela que el material genético puede conservar información biológica incluso bajo la intensa radiación marciana. Basado en experimentos con rocas terrestres análogas, el estudio sugiere que estas moléculas podrían actuar como biomarcadores en la búsqueda de vida pasada en el planeta rojo."@es ;
