    simanw:mencionaEntidad data:entidad_aunque,
        data:entidad_estamos,
        data:entidad_londres,
        data:entidad_reino_unido,
        data:entidad_synnovis ;
    simanw:publicadaPor data:fuente_https_www_genbeta_com_index_xml ;
    simanw:resumen """Estamos acostumbrados a que la mayoría de noticias sobre cibercrimen giren en torno a causas políticas... o, mucho más frecuentemente, al dinero: rescates millonarios, caídas de sistemas de grandes compañías, pérdidas bursátiles y grandes estafas online.

Sin embargo, este 2025 del que nos despedimos puede haber marcado un punto de inflexión, porqu"""@es ;
    simanw:sentimientoEtiqueta "negativo"@es ;
    simanw:sentimientoScore "-0.9371"^^xsd:float ;
    simanw:tieneCategoria data:categoria_tecnologia ;
    simanw:tieneSentimiento data:sentimiento_negativo ;
    simanw:titulo "El cibercrimen ya no sólo es digital: 2025 ha sumado muertes y torturas a su historial"@es ;
    simanw:tokensClave "cibercrimen, sólo, digital, sumado, muertes, torturas, historial, acostumbrados, mayoría, noticias, cibercrimen, giren, torno, causas, políticas"@es ;
    simanw:url <https://www.genbeta.com/seguridad/cibercrimen-no-solo-digital-2025-ha-sumado-muertes-torturas-a-su-historial> .

